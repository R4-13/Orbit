// Project ORBIT — Prisma schema (Phase 2: vollständiges Multi-Tenant-Datenmodell).
//
// Architektur-Entscheidungen, die dieses Schema prägen (siehe docs/ASSUMPTIONS.md
// für die vollständige Begründung jeder einzelnen Annahme):
//
// - Single-Tenant-Membership: ein User gehört genau einem Tenant (User.email ist
//   global eindeutig). Ein Wechsel zu Multi-Tenant-Membership pro User wäre ein
//   Breaking Change (zusätzliche Join-Tabelle User<->Tenant) und wird nicht für
//   den MVP benötigt.
// - Permission-Strings (RolePermission.permission) und Policy-Action-Strings
//   (PolicyConfig.action, ToolInvocation.policyAction) sind bewusst `String`,
//   nicht Prisma-Enum: die kanonische, versionierte Liste lebt bereits in
//   @orbit/shared (permissions.ts, policy.ts) — siehe Kommentar dort ("single
//   source of truth"). Ein DB-Enum müsste bei jedem neuen Tool/jeder neuen
//   Permission per Migration mitgezogen werden, was Anwendungs- und
//   Datenbank-Ebene unnötig koppelt. Validierung erfolgt in der Service-Schicht.
// - AuditLog.actorUserId ist bewusst KEINE Foreign-Key-Relation zu User: das
//   Audit-Log muss unveränderlich bleiben und unabhängig von der Lebensdauer
//   eines Nutzeraccounts (Löschung/Deaktivierung) lesbar bleiben (§31 Audit
//   Trail, DSGVO-Nachvollziehbarkeit).
// - Tenant-Isolation wird in Phase 2 nur strukturell (tenant_id auf jeder
//   Fachtabelle + Indizes) hergestellt. Die Durchsetzung erfolgt über
//   tenant-scoped Repository-Helfer in @orbit/domain (Phase 3) als
//   Anwendungs-Verteidigungslinie, ergänzt in Phase 15 (Security Hardening)
//   um echtes Postgres Row-Level-Security als DB-Verteidigungslinie (siehe
//   migrations/20260921124445_enable_row_level_security und
//   packages/domain/src/tenant-scope.ts).
// - Geldbeträge sind `Decimal(14,2)` (kein Float), um Rundungsfehler in der
//   Finanzbuchhaltung auszuschließen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  /// Amendment 03 §6.2: Lebenszyklus der Plattform (Bereitstellung → aktiv → ausgesetzt → Offboarding → geschlossen).
  PROVISIONING
  OFFBOARDING
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

/// Muss mit POLICY_MODES in packages/shared/src/policy.ts synchron gehalten werden.
enum PolicyMode {
  DISABLED
  SUGGEST_ONLY
  REQUIRE_APPROVAL
  AUTONOMOUS
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  /// Amendment 03: Handlung einer Plattformidentität (Betreiber), nicht eines Mandantennutzers.
  PLATFORM_USER
}

/// Amendment 03 / Governance: dieselbe Audit-Tabelle für beide Sicherheitsdomänen. PLATFORM-Zeilen haben nie eine `tenant_id` und sind unveränderlich.
enum AuditDomain {
  TENANT
  PLATFORM
}

enum CaseType {
  FINANCE
  SALES
  /// Amendment 02 §7.1 — domänen-neutraler Case (z. B. Review-Case für ein unbekanntes Ziel); trägt keine eigene Fachlogik.
  GENERAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_APPROVAL
  DONE
  CANCELLED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskSource {
  AGENT
  USER
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum SupplierStatus {
  ACTIVE
  PENDING_APPROVAL
  BLOCKED
}

enum InvoiceStatus {
  RECEIVED
  EXTRACTED
  DUPLICATE_SUSPECTED
  /// §59 Szenario C: die auf der Rechnung ausgewiesene Bankverbindung des
  /// Lieferanten weicht von der bereits hinterlegten ab — klassisches
  /// Betrugsmuster (kompromittierte Lieferanten-E-Mail), erfordert
  /// zwingend eine menschliche Bestätigung, bevor der normale
  /// Freigabe-Workflow fortgesetzt wird.
  BANK_CHANGE_SUSPECTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  TRANSFERRED
  TRANSFER_FAILED
}

enum BookingProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum FinanceTransferStatus {
  STARTED
  COMPLETED
  FAILED
}

enum ApprovalEntityType {
  INVOICE
  BOOKING_PROPOSAL
  SUPPLIER
  FOLLOW_UP
  /// Amendment 02: eine Freigabe für eine vorbereitete externe Wirkung (`ActionIntent`), gebunden an Nutzlast-Hash und Planrevision.
  PROCESS_ACTION
  MEETING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadSource {
  EMAIL
  PHONE
  WEB
  MANUAL
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  NEW
  QUALIFICATION
  PROPOSAL
  WON
  LOST
}

enum MeetingStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

/// Muss mit den *_CONNECTOR-Enums in packages/config/src/env.ts synchron bleiben.
enum IntegrationConnectorType {
  DATEV
  LEXWARE
  MICROSOFT
  GMAIL
  GOOGLE_CALENDAR
  HUBSPOT
  TWILIO
}

/// §10 des Integration-Framework-Amendments (ORBIT_MASTER_SPECIFICATION_v3_AMENDMENT_01):
/// CONNECTING (OAuth-Flow gestartet, noch kein Callback), DEGRADED (verbunden,
/// aber mit eingeschränkter Funktion — z. B. ein Health-Check-Fehlschlag ohne
/// Auth-Verlust) und AUTH_REQUIRED (Token abgelaufen/widerrufen, Nutzer muss
/// sich erneut autorisieren, ohne dass Credentials verloren gingen) ergänzen
/// die vier ursprünglichen Werte.
enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTING
  CONNECTED
  DEGRADED
  AUTH_REQUIRED
  DISCONNECTED
  ERROR
}

/// Muss mit AgentBaseType in packages/shared/src/agent-definitions.ts synchron gehalten werden.
enum AgentType {
  ORCHESTRATOR
  COMMUNICATION
  FINANCE
  SALES
}

enum AgentRunTriggerType {
  EMAIL
  WEBHOOK
  SCHEDULE
  MANUAL
}

/// WAITING_FOR_APPROVAL/REJECTED (docs/ORBIT_UNIFIED_EVOLUTION_CONCEPT.md
/// §5-6, "Durable Orchestration") sind seit Phase 1 dieses Konzepts nur
/// für WorkflowRun.status in Gebrauch, nicht für AgentRun.status — ein
/// AgentRun schließt synchron mit runTurn() ab, auch wenn einer seiner
/// Tool-Aufrufe blockiert wurde (siehe FollowUpsModule); "wartend" ist
/// dort ein Zustand des umgebenden WorkflowRun/Approval, nicht des
/// AgentRun selbst. Geteiltes Enum trotzdem beibehalten statt eines
/// separaten WorkflowRunStatus, um keine Parallelstruktur einzuführen.
enum AgentRunStatus {
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  REJECTED
}

enum ToolInvocationStatus {
  SUCCESS
  FAILED
  BLOCKED_AWAITING_APPROVAL
  DENIED
  /// Amendment 02 §15.2 — die externe Wirkung ist möglicherweise eingetreten (z. B. Timeout nach Versand); niemals blind wiederholen.
  OUTCOME_UNKNOWN
}

/// Amendment 02 §12.1 — Schrittzustände. Der Zustand eines StepRun ist die Quelle der Wahrheit dafür, ob ein Schritt wirklich erfolgreich war (nicht „es gab keine Exception").
enum WorkflowStepRunStatus {
  PLANNED
  READY
  RUNNING
  WAITING
  AWAITING_APPROVAL
  SUCCEEDED
  SKIPPED
  BLOCKED
  FAILED
  CANCELLED
  SUPERSEDED
  OUTCOME_UNKNOWN
}

/// Agenten-Konfiguration (docs/AGENT_STUDIO_CONCEPT.md Abschnitt 1).
/// DRAFT: wird bearbeitet, läuft in keinem echten Aufruf. ACTIVE: von
/// IntakeService (siehe apps/api/src/intake/) tatsächlich auflösbar.
/// DISABLED: vorübergehend deaktiviert, Historie bleibt erhalten.
enum AgentDefinitionStatus {
  DRAFT
  ACTIVE
  DISABLED
}

// ============================================================================
// Tenant & Auth (RBAC)
// ============================================================================

model Tenant {
  aiUsageRecords            AIUsageRecord[]
  id                        String          @id @default(uuid())
  name                      String
  slug                      String          @unique
  status                    TenantStatus    @default(ACTIVE)
  locale                    String          @default("de-DE")
  timezone                  String          @default("Europe/Berlin")
  /// §52 DSGVO-Löschworkflow: gesetzt durch POST /tenants/me/deletion-request,
  /// Voraussetzung für POST /tenants/me/deletion-confirm. Zwei getrennte
  /// Aufrufe als bewusste Sicherheitshürde gegen versehentliche Löschung.
  deletionRequestedAt       DateTime?       @map("deletion_requested_at")
  deletionRequestedByUserId String?         @map("deletion_requested_by_user_id")
  /// Amendment 03 §6: Rollout-Kohorten und feingranulare Sperrarten (LOGIN, AUTOMATION, CONNECTORS, BILLING, SECURITY_QUARANTINE).
  featureCohorts            String[]        @default([]) @map("feature_cohorts")
  suspensionScopes          String[]        @default([]) @map("suspension_scopes")
  lifecycleNote             String?         @map("lifecycle_note")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  users                        User[]
  roles                        Role[]
  policyConfigs                PolicyConfig[]
  auditLogs                    AuditLog[]
  cases                        Case[]
  tasks                        Task[]
  documents                    Document[]
  emailMessages                EmailMessage[]
  suppliers                    Supplier[]
  invoices                     Invoice[]
  bookingProposals             BookingProposal[]
  financeTransfers             FinanceTransfer[]
  approvals                    Approval[]
  companies                    Company[]
  contacts                     Contact[]
  leads                        Lead[]
  opportunities                Opportunity[]
  meetings                     Meeting[]
  integrations                 Integration[]
  integrationCredentialSecrets IntegrationCredentialSecret[]
  aiProviderConnection         AIProviderConnection?
  branding                     TenantBranding?
  profile                      TenantProfile?
  staffMembers                 StaffMember[]
  attentionItems               AttentionItem[]
  staffNotifications           StaffNotification[]
  conversations                Conversation[]
  conversationMessages         ConversationMessage[]
  agentRuns                    AgentRun[]
  toolInvocations              ToolInvocation[]
  webhookEvents                WebhookEvent[]
  retentionPolicies            RetentionPolicy[]
  agentDefinitions             AgentDefinition[]
  agentDefinitionVersions      AgentDefinitionVersion[]
  agentEvaluationCases         AgentEvaluationCase[]
  workflowDefinitions          WorkflowDefinition[]
  workflowStepDefinitions      WorkflowStepDefinition[]
  workflowRuns                 WorkflowRun[]
  workflowStepRuns             WorkflowStepRun[]
  connectorSyncs               ConnectorSync[]
  intakeEvents                 IntakeEvent[]
  mockCrmRecords               MockCrmRecord[]
  intakeDecisions              IntakeDecision[]
  caseFacts                    CaseFact[]
  caseCorrelations             CaseCorrelation[]
  processBlueprints            ProcessBlueprint[]
  referenceCatalogItems        ReferenceCatalogItem[]
  referenceRequirementRules    ReferenceRequirementRule[]
  communicationDrafts          CommunicationDraft[]
  quotes                       Quote[]
  tenantSequences              TenantSequence[]
  processActivations           TenantProcessActivation[]
  processPlans                 ProcessPlan[]
  processPlanNodes             ProcessPlanNode[]
  processPlanEdges             ProcessPlanEdge[]
  actionIntents                ActionIntent[]
  actionReceipts               ActionReceipt[]
  waitSubscriptions            WaitSubscription[]
  caseEvents                   CaseEvent[]
  caseCommands                 CaseCommand[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  assignedCases Case[] @relation("CaseAssignee")
  assignedTasks Task[] @relation("TaskAssignee")

  conversations        Conversation[]
  conversationMessages ConversationMessage[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Tenant-scoped Rolle. Beim Tenant-Bootstrap aus DEFAULT_ROLE_PERMISSIONS
/// (@orbit/shared) geseedet; Permission-Zuordnung ist pro Tenant anpassbar.
model Role {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String @map("role_id")
  /// Permission-String aus PERMISSIONS (@orbit/shared/permissions.ts), z. B. "invoice.approve".
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// Policy Engine (§17)
// ============================================================================

/// Ein Eintrag pro Tenant und Policy-Action. Beim Tenant-Bootstrap aus
/// DEFAULT_POLICY_CONFIG (@orbit/shared/policy.ts) geseedet.
model PolicyConfig {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  /// Action-Key aus POLICY_ACTIONS (@orbit/shared/policy.ts), z. B. "invoice.transfer_to_fibu".
  action          String
  mode            PolicyMode
  /// Wenn true, darf ein Tenant-Admin diese Action nicht unter REQUIRE_APPROVAL absenken.
  locked          Boolean    @default(false)
  updatedByUserId String?    @map("updated_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, action])
  @@map("policy_configs")
}

// ============================================================================
// Audit Trail (§31)
// ============================================================================

/// Append-only. Kein FK auf User (siehe Datei-Kopfkommentar) — das Log muss
/// unabhängig von Nutzer-Lifecycle lesbar bleiben.
model AuditLog {
  id                  String      @id @default(uuid())
  /// NULL nur für `domain = PLATFORM` (CHECK-Constraint); Mandantenzeilen behalten Pflicht-Mandant + Cascade (DSGVO-Löschung).
  tenantId            String?     @map("tenant_id")
  domain              AuditDomain @default(TENANT)
  /// Event-Typ aus AUDIT_EVENT_TYPES (@orbit/shared/audit.ts).
  eventType           String      @map("event_type")
  actorType           ActorType   @map("actor_type")
  actorUserId         String?     @map("actor_user_id")
  /// Plattform-Domäne: handelnde Plattformidentität (kein FK – der Audit-Eintrag überlebt jede Identitätsverwaltung).
  actorPlatformUserId String?     @map("actor_platform_user_id")
  /// Plattform-Domäne: betroffener Mandant (ohne FK, damit eine Mandantenlöschung das Betreiber-Audit nicht kaskadiert löscht).
  targetTenantId      String?     @map("target_tenant_id")
  correlationId       String?     @map("correlation_id")
  supportSessionId    String?     @map("support_session_id")
  entityType          String?     @map("entity_type")
  entityId            String?     @map("entity_id")
  payload             Json?
  createdAt           DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([domain, createdAt])
  @@index([targetTenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Cases / Tasks / Documents / Kommunikation (Phase 4)
// ============================================================================

/// Der übergreifende Vorgang (Finance- oder Sales-Prozessinstanz), an dem
/// Tasks, Dokumente, E-Mails und fachliche Entitäten (Invoice, Lead, ...) hängen.
model Case {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  type        CaseType
  status      CaseStatus @default(OPEN)
  title       String
  description String?
  assigneeId  String?    @map("assignee_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // --- Amendment 02 §7.1 Universal Case (additiv; `status` bleibt die bestehende, einfache UI-Sicht) ---
  /// Feingranularer Prozesszustand (§12.1). `status` wird daraus über `caseStatusFor()` (@orbit/shared) abgeleitet: eine Mapping-Tabelle, kein zweiter Statusautomat im Frontend.
  orchestrationStatus CaseOrchestrationStatus @default(RECEIVED) @map("orchestration_status")
  /// Monoton steigend bei jeder fachlichen Änderung; Commands und Events prüfen dagegen (§12.3, §21.2).
  revision            Int                     @default(1)
  businessGoals       String[]                @default([]) @map("business_goals")
  currentIntent       String?                 @map("current_intent")
  attentionReasons    String[]                @default([]) @map("attention_reasons")
  blueprintKey        String?                 @map("blueprint_key")
  blueprintVersion    String?                 @map("blueprint_version")
  /// Nur gesetzt, wenn die Abschlusskriterien nachweislich erfüllt sind: `{ code, evidenceRefs }`.
  outcome             Json?
  completedAt         DateTime?               @map("completed_at")
  /// Zähler für `CaseEvent.sequence` (pro Case lückenlos, wird in derselben Transaktion wie das Event erhöht).
  eventSequence       Int                     @default(0) @map("event_sequence")
  /// Orchestrator-Lease (§12.3): nur ein Worker bearbeitet einen Case; Ablauf wiederholt keine bereits gestartete externe Wirkung blind.
  leaseOwner          String?                 @map("lease_owner")
  leaseExpiresAt      DateTime?               @map("lease_expires_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tasks               Task[]
  documents           Document[]
  emailMessages       EmailMessage[]
  invoices            Invoice[]
  leads               Lead[]
  agentRuns           AgentRun[]
  workflowRuns        WorkflowRun[]
  intakeEvents        IntakeEvent[]
  facts               CaseFact[]
  correlations        CaseCorrelation[]
  processPlans        ProcessPlan[]
  actionIntents       ActionIntent[]
  waitSubscriptions   WaitSubscription[]
  caseEvents          CaseEvent[]
  caseCommands        CaseCommand[]
  communicationDrafts CommunicationDraft[]
  quotes              Quote[]
  attentionItems      AttentionItem[]

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, orchestrationStatus])
  @@map("cases")
}

model Task {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  caseId      String?    @map("case_id")
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  source      TaskSource @default(USER)
  dueDate     DateTime?  @map("due_date")
  assigneeId  String?    @map("assignee_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([caseId])
  @@map("tasks")
}

/// Metadaten zu einer in S3/MinIO abgelegten Datei (siehe ASSUMPTIONS #6).
/// storageKey ist der Object-Key im Bucket, niemals ein direkt aufrufbarer Pfad.
model Document {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  caseId           String?  @map("case_id")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  storageKey       String   @map("storage_key")
  checksum         String?
  uploadedByUserId String?  @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  @@index([tenantId])
  @@index([caseId])
  @@map("documents")
}

model EmailMessage {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  caseId            String?        @map("case_id")
  direction         EmailDirection
  fromAddress       String         @map("from_address")
  toAddresses       String[]       @map("to_addresses")
  subject           String?
  bodyPreview       String?        @map("body_preview")
  providerMessageId String?        @map("provider_message_id")
  /// Amendment 02 §5.1 — normalisierter Volltext (begrenzt) als Grundlage für Triage-Wiederholung und Faktenextraktion; `bodyPreview` bleibt die Kurzfassung für Listen.
  bodyText          String?        @map("body_text")
  /// SHA-256 des normalisierten Inhalts (Betreff + Text + Anhangsnamen) — Duplikat-/Replay-Erkennung.
  contentHash       String?        @map("content_hash")
  /// Provider-Thread (z. B. Gmail threadId) und RFC-5322-Kopfzeilen für die Case Correlation (§13.1).
  threadId          String?        @map("thread_id")
  rfcMessageId      String?        @map("rfc_message_id")
  inReplyTo         String?        @map("in_reply_to")
  references        String[]       @default([])
  /// Grobklassifikation durch den Communication-Agent, z. B. "invoice", "sales_inquiry".
  classification    String?
  receivedAt        DateTime?      @map("received_at")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case        Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  intakeEvent IntakeEvent?

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, direction])
  @@index([tenantId, threadId])
  @@index([tenantId, rfcMessageId])
  @@index([caseId])
  @@map("email_messages")
}

// ============================================================================
// Finance (Phase 7)
// ============================================================================

model Supplier {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  name              String
  taxId             String?        @map("tax_id")
  vatId             String?        @map("vat_id")
  iban              String?
  bic               String?
  email             String?
  addressLine1      String?        @map("address_line1")
  addressLine2      String?        @map("address_line2")
  postalCode        String?        @map("postal_code")
  city              String?
  country           String?        @default("DE")
  status            SupplierStatus @default(PENDING_APPROVAL)
  /// Lieferanten-ID im angebundenen FiBu-System (DATEV/Lexware).
  externalFinanceId String?        @map("external_finance_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("suppliers")
}

model Invoice {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  caseId               String?       @map("case_id")
  supplierId           String?       @map("supplier_id")
  documentId           String?       @map("document_id")
  invoiceNumber        String?       @map("invoice_number")
  invoiceDate          DateTime?     @map("invoice_date")
  dueDate              DateTime?     @map("due_date")
  amountNet            Decimal?      @map("amount_net") @db.Decimal(14, 2)
  amountGross          Decimal?      @map("amount_gross") @db.Decimal(14, 2)
  vatAmount            Decimal?      @map("vat_amount") @db.Decimal(14, 2)
  vatRate              Decimal?      @map("vat_rate") @db.Decimal(5, 2)
  currency             String        @default("EUR")
  status               InvoiceStatus @default(RECEIVED)
  /// Extraktions-Konfidenz (0..1) des OCR/LLM-Auslesevorgangs; steuert LowConfidenceError-Schwelle.
  confidenceScore      Float?        @map("confidence_score")
  /// Roh-Extraktionsergebnis (Feld-für-Feld inkl. Konfidenzwerten) zur Nachvollziehbarkeit.
  extractedData        Json?         @map("extracted_data")
  duplicateOfInvoiceId String?       @map("duplicate_of_invoice_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  duplicateOf      Invoice?          @relation("InvoiceDuplicate", fields: [duplicateOfInvoiceId], references: [id], onDelete: SetNull)
  duplicates       Invoice[]         @relation("InvoiceDuplicate")
  bookingProposals BookingProposal[]
  financeTransfers FinanceTransfer[]

  @@index([tenantId, status])
  @@index([supplierId])
  @@map("invoices")
}

model BookingProposal {
  id          String                @id @default(uuid())
  tenantId    String                @map("tenant_id")
  invoiceId   String                @map("invoice_id")
  /// Sachkonto (z. B. SKR03/SKR04-Kontonummer).
  accountCode String                @map("account_code")
  costCenter  String?               @map("cost_center")
  amount      Decimal               @db.Decimal(14, 2)
  taxCode     String?               @map("tax_code")
  description String?
  status      BookingProposalStatus @default(PROPOSED)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("booking_proposals")
}

model FinanceTransfer {
  id                String                @id @default(uuid())
  tenantId          String                @map("tenant_id")
  invoiceId         String                @map("invoice_id")
  /// FINANCE_CONNECTOR-Wert (@orbit/config/env.ts), z. B. "datev", "lexware", "mock".
  connector         String
  externalReference String?               @map("external_reference")
  status            FinanceTransferStatus @default(STARTED)
  errorMessage      String?               @map("error_message")
  startedAt         DateTime              @default(now()) @map("started_at")
  completedAt       DateTime?             @map("completed_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("finance_transfers")
}

// ============================================================================
// Approvals (generische Freigabe-Warteschlange der Policy Engine)
// ============================================================================

model Approval {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  entityType        ApprovalEntityType @map("entity_type")
  entityId          String             @map("entity_id")
  /// Action-Key aus POLICY_ACTIONS, der diese Freigabe ausgelöst hat.
  policyAction      String             @map("policy_action")
  status            ApprovalStatus     @default(PENDING)
  requestedByUserId String?            @map("requested_by_user_id")
  decidedByUserId   String?            @map("decided_by_user_id")
  reason            String?
  requestedAt       DateTime           @default(now()) @map("requested_at")
  decidedAt         DateTime?          @map("decided_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([entityType, entityId])
  @@map("approvals")
}

// ============================================================================
// Sales / CRM (Phase 8)
// ============================================================================

model Company {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  domain        String?
  industry      String?
  /// Company-ID im angebundenen CRM (HubSpot).
  crmExternalId String?  @map("crm_external_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@map("companies")
}

model Contact {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  companyId     String?  @map("company_id")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String?
  phone         String?
  crmExternalId String?  @map("crm_external_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  leads         Lead[]
  opportunities Opportunity[]
  meetings      Meeting[]

  @@index([tenantId])
  @@index([companyId])
  @@map("contacts")
}

model Lead {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  caseId    String?    @map("case_id")
  contactId String     @map("contact_id")
  companyId String?    @map("company_id")
  source    LeadSource
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case    Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  opportunities Opportunity[]

  @@index([tenantId, status])
  @@map("leads")
}

model Opportunity {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  leadId        String?          @map("lead_id")
  companyId     String?          @map("company_id")
  contactId     String?          @map("contact_id")
  name          String
  stage         OpportunityStage @default(NEW)
  value         Decimal?         @db.Decimal(14, 2)
  currency      String           @default("EUR")
  crmExternalId String?          @map("crm_external_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  meetings Meeting[]

  @@index([tenantId, stage])
  @@map("opportunities")
}

model Meeting {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  contactId          String?       @map("contact_id")
  opportunityId      String?       @map("opportunity_id")
  title              String
  /// Vorgeschlagene Terminslots (Array von ISO-Zeitfenstern) vor Bestätigung.
  proposedSlots      Json?         @map("proposed_slots")
  scheduledAt        DateTime?     @map("scheduled_at")
  status             MeetingStatus @default(PROPOSED)
  calendarExternalId String?       @map("calendar_external_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("meetings")
}

// ============================================================================
// Integrationen / Connector-Credentials (Phase 5, 9-11)
// ============================================================================

/// Ein Eintrag pro Tenant und Connector-Typ — entspricht der
/// `IntegrationConnection` aus dem Integration-Framework-Amendment
/// (ORBIT_MASTER_SPECIFICATION_v3_AMENDMENT_01, §6). Speichert bewusst
/// **keine** Secrets/Tokens direkt: `credentialReference` verweist auf einen
/// `IntegrationCredentialSecret`-Datensatz hinter der
/// `CredentialVaultService`-Abstraktion (echtes AES-256-GCM via
/// `CredentialEncryptionService`, siehe ASSUMPTIONS) — Connector-/Business-
/// Code liest/schreibt Secrets nie direkt aus dieser Tabelle.
/// `externalAccountId`/`externalAccountDisplayName` werden dynamisch aus dem
/// jeweiligen Provider-Kontext nach erfolgreichem OAuth-Flow ermittelt (§7.2.1
/// — niemals ein fest im Code hinterlegter Beispielwert).
model Integration {
  id                         String                   @id @default(uuid())
  tenantId                   String                   @map("tenant_id")
  connectorType              IntegrationConnectorType @map("connector_type")
  status                     IntegrationStatus        @default(NOT_CONFIGURED)
  /// Verweist auf `IntegrationCredentialSecret.id` — niemals ein Secret selbst.
  credentialReference        String?                  @map("credential_reference")
  /// Dynamisch vom Provider ermittelt (z. B. die autorisierte Google-Account-ID), nie hartcodiert.
  externalAccountId          String?                  @map("external_account_id")
  /// Dynamisch vom Provider ermittelt (z. B. die autorisierte E-Mail-Adresse), nie hartcodiert.
  externalAccountDisplayName String?                  @map("external_account_display_name")
  /// Tatsächlich gewährte Capability-Strings (z. B. ["email.read"]) — kann enger sein als vom Connector maximal unterstützt.
  grantedCapabilities        Json?                    @map("granted_capabilities")
  /// Nicht-geheime Konfiguration (z. B. gewählte DATEV-Umgebung, Postfach-Adresse).
  config                     Json?
  lastTestedAt               DateTime?                @map("last_tested_at")
  lastTestStatus             String?                  @map("last_test_status")
  lastSuccessAt              DateTime?                @map("last_success_at")
  lastErrorAt                DateTime?                @map("last_error_at")
  lastErrorCode              String?                  @map("last_error_code")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectorSync ConnectorSync?
  intakeEvents  IntakeEvent[]

  @@unique([tenantId, connectorType])
  @@map("integrations")
}

/// Die physische Ablage hinter `CredentialVaultService` (MVP-Implementierung
/// der generischen Credential-/Secret-Store-Abstraktion aus dem Integration-
/// Framework-Amendment §6) — austauschbar gegen einen externen Secret
/// Manager, ohne `Integration.credentialReference` oder Connector-Code zu
/// ändern (die Referenz bliebe eine opake String-ID). `encryptedValue` nutzt
/// dasselbe AES-256-GCM-Verfahren wie zuvor direkt auf `Integration`
/// (`CredentialEncryptionService`, unverändert wiederverwendet).
model IntegrationCredentialSecret {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  encryptedValue Bytes    @map("encrypted_value")
  /// Für künftige Secret-Rotation (§6) — beginnt bei 1, erhöht sich bei jedem `updateSecret()`.
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("integration_credential_secrets")
}

// ============================================================================
// Channel Event Runtime (Intake)
// ============================================================================

/// §10 der Master-Spezifikation listet `ConnectorSync` als eigenes Modell,
/// getrennt von `Integration` — `Integration` bleibt Authentifizierungs-/
/// Konfigurationszustand (OAuth-Tokens via `credentialReference`,
/// nicht-geheime Konfiguration via `config: Json?`), `ConnectorSync` ist
/// der sich bei jedem Sync-Versuch ändernde Laufzeitzustand (Cursor,
/// Zeitpunkte, Fehlerzähler). Eine Zeile pro `Integration`
/// (`@@unique([tenantId, connectionId])`) — ohne Zeile hat diese
/// Connection noch nie synchronisiert.
enum ConnectorSyncMode {
  WEBHOOK
  POLLING
  ON_DEMAND
  BATCH
}

enum ConnectorSyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model ConnectorSync {
  id            String                   @id @default(uuid())
  tenantId      String                   @map("tenant_id")
  connectionId  String                   @unique @map("connection_id")
  connectorType IntegrationConnectorType @map("connector_type")
  syncMode      ConnectorSyncMode        @map("sync_mode")
  /// Opaker Fortsetzungspunkt (z. B. die zuletzt gesehene Gmail-Message-ID) — vom jeweiligen Channel-Poll-Adapter interpretiert, nie vom generischen Sync-Runtime selbst geparst.
  cursor        String?
  status        ConnectorSyncStatus      @default(IDLE)
  lastAttemptAt DateTime?                @map("last_attempt_at")
  lastSuccessAt DateTime?                @map("last_success_at")
  nextRunAt     DateTime?                @map("next_run_at")
  retryCount    Int                      @default(0) @map("retry_count")
  lastErrorCode String?                  @map("last_error_code")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection Integration @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, nextRunAt])
  @@map("connector_syncs")
}

enum IntakeChannel {
  EMAIL
  /// Der manuelle "Eingehende E-Mail simulieren"-Pfad auf /inbox — bewusst ein eigener Channel-Wert statt `EMAIL`, damit echte und simulierte Events im Audit/Reporting unterscheidbar bleiben, obwohl beide denselben `IntakeService.handleIntakeEvent()`-Pfad durchlaufen.
  SIMULATED
}

/// Channel-unabhängige Relevanz-Einstufung, VOR jeder Domain-Klassifikation
/// (FINANCE/SALES/OTHER) — entkoppelt "ist das überhaupt geschäftlich
/// relevant" von "zu welcher Domäne gehört es". Gilt identisch für
/// künftige Nicht-E-Mail-Kanäle (Telefon, Web, Messenger).
enum IntakeRelevance {
  BUSINESS_ACTIONABLE
  BUSINESS_INFORMATIONAL
  NON_ACTIONABLE
  PRIVATE_PERSONAL
  UNKNOWN_REQUIRES_REVIEW
}

enum IntakeEventStatus {
  RECEIVED
  /// Amendment 02 §5.3 — die semantische Triage konnte (noch) nicht laufen (Provider-Ausfall); der Eingang geht nicht verloren und wird erneut versucht.
  PENDING_TRIAGE
  TRIAGED
  ROUTED
  PROCESSING
  COMPLETED
  SKIPPED_NON_ACTIONABLE
  NEEDS_REVIEW
  FAILED
}

/// Der normalisierte, channel-unabhängige Orchestrierungs-Datensatz für
/// jedes eingehende externe Ereignis (§7 des Integration-Framework-
/// Amendments, §12-17/§29 der Master-Spezifikation). Bewusst **kein**
/// Duplikat der vollständigen Quelldaten — der E-Mail-Body bleibt
/// ausschließlich auf `EmailMessage` (via `emailMessageId`-Referenz),
/// Anhänge bleiben auf `Document` (via `documentIds`-Referenzliste, keine
/// eigene FK-Beziehung pro Eintrag — dieselbe lose Referenzkonvention wie
/// `EmailMessage.toAddresses: String[]`). `IntakeEvent` trägt nur, was der
/// Orchestrierungs-/Triage-/Routing-Entscheidungspfad selbst braucht.
model IntakeEvent {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  /// `Integration.id` — null beim SIMULATED-Channel (kein echter Connector dahinter).
  connectionId    String?       @map("connection_id")
  channel         IntakeChannel
  /// z. B. "gmail" | "simulated" — freier String statt Enum, damit neue Provider keine Migration brauchen (vgl. `ConnectorMetadata.provider` in packages/integration-core).
  provider        String
  /// Die eigene Ereignis-/Nachrichten-ID des Providers (z. B. Gmail-Message-ID) — zusammen mit `tenantId`+`provider` die Idempotenz-Grenze, siehe `@@unique` unten. Bei SIMULATED eine generierte UUID.
  externalEventId String        @map("external_event_id")
  occurredAt      DateTime      @map("occurred_at")

  /// `PartyReference`-JSON ({address?, displayName?}) — bewusst JSON statt fester E-Mail-Spalten, damit künftige Kanäle (Telefon: Nummer statt Adresse) keine neue Spalte brauchen.
  senderRef     Json?   @map("sender_ref")
  recipientRefs Json?   @map("recipient_refs")
  subject       String?

  /// Verweis auf den vollständigen Quelldatensatz — der Body bleibt dort, nicht hier dupliziert.
  emailMessageId String?  @unique @map("email_message_id")
  documentIds    String[] @map("document_ids")

  relevance      IntakeRelevance?
  /// Bewusst ein freier String statt eines harten Enums (nur FINANCE/SALES/OTHER heute) — neue Domänen dürfen ohne Schema-Migration hinzukommen.
  domainCategory String?          @map("domain_category")
  caseId         String?          @map("case_id")
  /// Korrelation zum durablen WorkflowRun — seit Increment G von `IntakeService.triggerWorkflow()` für jedes FINANCE/SALES-Intake-Event gesetzt (vorher stets null, da Finance/Sales über den inzwischen entfernten `runAgentTurn()`-Pfad liefen).
  workflowRunId  String?          @map("workflow_run_id")

  status       IntakeEventStatus @default(RECEIVED)
  errorMessage String?           @map("error_message")

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   Integration?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  emailMessage EmailMessage?   @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  case         Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  workflowRun  WorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  decision     IntakeDecision?

  @@unique([tenantId, provider, externalEventId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("intake_events")
}

/// §35-44 des Unified-Evolution-Konzepts ("LLM Provider Strategy") — BYOK-
/// Override für einen Tenant. Bewusst getrennt von `Integration`/
/// `IntegrationConnectorType` (die dortige Header-Notiz verlangt Sync mit
/// den `*_CONNECTOR`-Env-Enums für Finance/Mail/Calendar/CRM/Telephony —
/// LLM-Provider sind kein Business-Connector, sondern eine eigene
/// Kategorie, gesteuert über `LLM_PROVIDER`/`ANTHROPIC_API_KEY`/
/// `OPENAI_API_KEY`). Höchstens eine Zeile pro Tenant (`@@unique(tenantId)`,
/// nicht pro Provider) — ein Tenant konfiguriert genau einen aktiven BYOK-
/// Provider zur Zeit, kein gleichzeitiges Mehrfach-Setup. Fehlt die Zeile
/// komplett, läuft der Tenant im ORBIT-Managed-Modus (Standard: die
/// plattformweite, envgesteuerte LLM_PROVIDER-Konfiguration) — siehe
/// docs/ASSUMPTIONS.md.
enum AIProviderKey {
  ANTHROPIC
  OPENAI
}

enum AIProviderConnectionStatus {
  NOT_CONFIGURED
  CONNECTED
  DISCONNECTED
  ERROR
}

model AIProviderConnection {
  id                   String                     @id @default(uuid())
  tenantId             String                     @unique @map("tenant_id")
  providerKey          AIProviderKey              @map("provider_key")
  status               AIProviderConnectionStatus @default(NOT_CONFIGURED)
  encryptedCredentials Bytes?                     @map("encrypted_credentials")
  /// Optionales Modell-Override (z. B. "gpt-4o" statt des Plattform-Defaults) — leer = Provider-Default aus @orbit/config verwenden.
  model                String?
  lastTestedAt         DateTime?                  @map("last_tested_at")
  lastTestStatus       String?                    @map("last_test_status")
  /// Amendment 03 §10: gesetzt, sobald der Mandant erfolgreich BYOK nutzt; ab dann gilt NO_FALLBACK (kein stilles Zurückfallen auf die Plattform). Wird nur durch ein ausdrückliches Trennen gelöscht.
  byokActiveSince      DateTime?                  @map("byok_active_since")
  createdByUserId      String?                    @map("created_by_user_id")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_provider_connections")
}

/// §5/§27 der UI/UX-Spezifikation ("Tenant/Company Branding and CI Theming") — pro
/// Tenant konfigurierbares Erscheinungsbild, ohne Code-Änderung wirksam (siehe
/// `apps/web/src/app/(app)/admin/branding/page.tsx`). `logoUrl` ist bewusst ein
/// einfaches URL-Feld statt einer Objektspeicher-Upload-Pipeline (MVP-Vereinfachung,
/// siehe docs/ASSUMPTIONS.md) — erfüllt trotzdem "Logo ohne Code-Änderung ersetzbar".
/// Höchstens eine Zeile pro Tenant; fehlt sie, gilt das in
/// apps/web/src/app/globals.css gebackene Standard-ORION-Theme.
enum BrandingBorderRadiusPreset {
  COMPACT
  STANDARD
  SOFT
}

model TenantBranding {
  id                   String                      @id @default(uuid())
  tenantId             String                      @unique @map("tenant_id")
  companyDisplayName   String?                     @map("company_display_name")
  logoUrl              String?                     @map("logo_url")
  logoMarkUrl          String?                     @map("logo_mark_url")
  primaryColor         String?                     @map("primary_color")
  primaryForeground    String?                     @map("primary_foreground")
  secondaryColor       String?                     @map("secondary_color")
  secondaryForeground  String?                     @map("secondary_foreground")
  accentColor          String?                     @map("accent_color")
  accentForeground     String?                     @map("accent_foreground")
  navigationBackground String?                     @map("navigation_background")
  navigationForeground String?                     @map("navigation_foreground")
  borderRadiusPreset   BrandingBorderRadiusPreset? @map("border_radius_preset")
  updatedByUserId      String?                     @map("updated_by_user_id")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brandings")
}

/// §25-33 des Master-Dokuments ("Sonde — application-wide copilot") /
/// §29 ("Conversation model"). Bewusst nur `Conversation` + `ConversationMessage`
/// in dieser ersten Stufe (Phase 6, "Conversation Foundation") — `ConversationSummary`/
/// `ConversationContext`/`ConversationReference` als eigene, persistierte Modelle
/// bewusst zurückgestellt (siehe docs/ASSUMPTIONS.md): für einen reinen ASK-Modus
/// ohne lange Konversationshistorie reicht "letzte N Nachrichten" als Kontext,
/// eine echte Zusammenfassungs-/Referenz-Persistenz wird erst mit PREPARE/ACT/
/// DELEGATE (spätere Phasen) tatsächlich gebraucht.
enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  SYSTEM_EVENT
}

model Conversation {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  userId        String             @map("user_id")
  title         String?
  status        ConversationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  lastMessageAt DateTime?          @map("last_message_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([tenantId, userId])
  @@map("conversations")
}

/// `content` ist bewusst reiner, für den Nutzer sichtbarer Text — kein
/// verstecktes Chain-of-Thought wird persistiert (§29: "Do not store hidden
/// chain-of-thought"). `agentRunId` verknüpft eine ASSISTANT-Nachricht optional
/// mit dem echten AgentRun/ToolInvocation-Datensatz dahinter (Audit/Activity).
model ConversationMessage {
  id             String                  @id @default(uuid())
  tenantId       String                  @map("tenant_id")
  conversationId String                  @map("conversation_id")
  userId         String?                 @map("user_id")
  role           ConversationMessageRole
  content        String
  agentRunId     String?                 @map("agent_run_id")
  createdAt      DateTime                @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("conversation_messages")
}

// ============================================================================
// Agent Runtime (Phase 6)
// ============================================================================

model AgentRun {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  caseId       String?             @map("case_id")
  agentType    AgentType           @map("agent_type")
  triggerType  AgentRunTriggerType @map("trigger_type")
  status       AgentRunStatus      @default(RUNNING)
  input        Json?
  output       Json?
  errorMessage String?             @map("error_message")
  startedAt    DateTime            @default(now()) @map("started_at")
  completedAt  DateTime?           @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  toolInvocations      ToolInvocation[]
  workflowStepRuns     WorkflowStepRun[]
  conversationMessages ConversationMessage[]

  @@index([tenantId, status])
  @@map("agent_runs")
}

/// Jeder Aufruf eines Tools aus der Tool Registry durch einen Agenten, inkl.
/// der von der Policy Engine getroffenen Entscheidung (§17-Architekturprinzip:
/// Agent -> Tool Registry -> Policy Engine -> ... -> Connector).
model ToolInvocation {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  agentRunId   String               @map("agent_run_id")
  /// = ToolCallOutcome.toolCallId (packages/agent-core) — ermöglicht
  /// FollowUpResumeService, die für eine blockierte Approval ursprünglich
  /// erzeugten Tool-Eingabeargumente wiederzufinden (Approval.entityId
  /// trägt denselben Wert). Kein @unique: von einer LLM/Mock-Provider
  /// erzeugte ID, keine harte DB-Garantie über Aufrufe hinweg erzwingen.
  toolCallId   String?              @map("tool_call_id")
  toolName     String               @map("tool_name")
  policyAction String?              @map("policy_action")
  policyMode   PolicyMode?          @map("policy_mode")
  input        Json?
  output       Json?
  status       ToolInvocationStatus
  createdAt    DateTime             @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([tenantId, toolName])
  @@index([tenantId, toolCallId])
  @@map("tool_invocations")
}

/// Konfigurierbarer Agent (docs/AGENT_STUDIO_CONCEPT.md Abschnitt 1):
/// System-Prompt + erlaubte Tool-Namen, editierbar über /admin/agents.
/// Ersetzt (sobald ACTIVE und von IntakeService aufgelöst) die bis
/// Phase 19 hart im Code verankerten Literal-Prompts. `allowedTools`
/// referenziert Tool-**Namen** aus der ToolRegistry (nicht Policy-
/// Actions) — die Policy Engine bleibt unabhängig davon die einzige
/// Instanz, die einen Tool-Aufruf tatsächlich freigibt (Sicherheitsmodell
/// im Konzept-Dokument).
model AgentDefinition {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  /// Stabiler Slug, z. B. "communication-intake" — von IntakeService zur
  /// Laufzeit aufgelöst.
  key             String
  name            String
  description     String?
  baseType        AgentType             @map("base_type")
  systemPrompt    String                @map("system_prompt")
  allowedTools    String[]              @map("allowed_tools")
  status          AgentDefinitionStatus @default(DRAFT)
  version         Int                   @default(1)
  createdByUserId String?               @map("created_by_user_id")
  updatedByUserId String?               @map("updated_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions AgentDefinitionVersion[]

  @@unique([tenantId, key])
  @@map("agent_definitions")
}

/// Append-only Änderungshistorie — jede Änderung an Prompt/Tools erzeugt
/// eine neue Zeile statt eines In-Place-Updates, analog zum bereits
/// etablierten Audit-Muster für PolicyConfig-Änderungen (Phase 19h,
/// POLICY_CONFIG_UPDATED). Ermöglicht Rollback und eine nachvollziehbare
/// Historie im Frontend.
model AgentDefinitionVersion {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  agentDefinitionId String   @map("agent_definition_id")
  version           Int
  systemPrompt      String   @map("system_prompt")
  allowedTools      String[] @map("allowed_tools")
  changeNote        String?  @map("change_note")
  changedByUserId   String?  @map("changed_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentDefinition AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  @@index([agentDefinitionId])
  @@map("agent_definition_versions")
}

/// §17 des Unified-Evolution-Konzepts ("Agent Evaluation Framework") — ein
/// gespeicherter, wiederholbarer Regressionsfall für ein AgentDefinition
/// (per `agentDefinitionKey`, kein FK — dieselbe Design-Entscheidung wie
/// WorkflowStepDefinition.agentDefinitionKey, siehe dortigen Kommentar).
/// `critical: true` gated die Aktivierung (siehe AgentDefinitionsService.update()):
/// eine Definition kann nicht auf ACTIVE wechseln, solange ein kritischer
/// Fall für ihren Key fehlschlägt.
model AgentEvaluationCase {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  agentDefinitionKey       String   @map("agent_definition_key")
  name                     String
  userMessage              String   @map("user_message")
  /// Tool-Namen, die beim Lauf aufgerufen worden sein müssen, damit der Fall besteht.
  expectedTools            String[] @map("expected_tools")
  /// Tool-Namen, die beim Lauf NICHT aufgerufen worden sein dürfen.
  forbiddenTools           String[] @map("forbidden_tools")
  /// null = nicht geprüft. true = mindestens ein Tool-Aufruf muss eine
  /// Freigabe erfordern (Decision != ALLOW). false = alle Tool-Aufrufe
  /// müssen ALLOW sein.
  expectedApprovalRequired Boolean? @map("expected_approval_required")
  critical                 Boolean  @default(false)
  createdByUserId          String?  @map("created_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentDefinitionKey])
  @@map("agent_evaluation_cases")
}

/// Orchestrierung (docs/AGENT_STUDIO_CONCEPT.md Abschnitt 3): eine
/// lineare Schrittfolge von AgentDefinitions mit optionaler
/// Ein-Ebenen-Bedingung — bewusst keine generische Workflow-Engine
/// (keine Parallel-Zweige, Schleifen, Wartezustände), siehe
/// Begründung im Konzept-Dokument.
enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  DISABLED
}

model WorkflowDefinition {
  id              String                   @id @default(uuid())
  tenantId        String                   @map("tenant_id")
  key             String
  name            String
  description     String?
  /// Rein informativ in dieser Phase — kein Trigger ruft eine
  /// WorkflowDefinition automatisch auf; siehe WorkflowRunnerService.
  triggerType     AgentRunTriggerType      @map("trigger_type")
  status          WorkflowDefinitionStatus @default(DRAFT)
  createdByUserId String?                  @map("created_by_user_id")
  updatedByUserId String?                  @map("updated_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  WorkflowStepDefinition[]
  runs   WorkflowRun[]

  @@unique([tenantId, key])
  @@map("workflow_definitions")
}

model WorkflowStepDefinition {
  id                   String @id @default(uuid())
  tenantId             String @map("tenant_id")
  workflowDefinitionId String @map("workflow_definition_id")
  order                Int
  /// AgentDefinition.key — kein FK, weil Reihenfolge/Existenz erst beim
  /// Ausführen geprüft wird (dieselbe Design-Entscheidung wie
  /// PolicyConfig.action als String statt Enum, siehe Schema-Kopf).
  agentDefinitionKey   String @map("agent_definition_key")
  /// JSON-Path-artiges Mapping (WorkflowRunnerService), z. B.
  /// { "companyName": "$.trigger.input.subject" }.
  inputMapping         Json?  @map("input_mapping")
  /// Optionale Bedingung gegen den Output eines vorherigen Schritts,
  /// z. B. { "field": "$.steps[1].output.classify_message.category",
  /// "equals": "SALES" }. Fehlt sie, läuft der Schritt immer.
  condition            Json?

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([workflowDefinitionId, order])
  @@map("workflow_step_definitions")
}

model WorkflowRun {
  id                   String         @id @default(uuid())
  tenantId             String         @map("tenant_id")
  workflowDefinitionId String         @map("workflow_definition_id")
  caseId               String?        @map("case_id")
  status               AgentRunStatus @default(RUNNING)
  input                Json?
  /// Snapshot von WorkflowPathContext.steps im Moment des Pausierens
  /// (status: WAITING_FOR_APPROVAL) — hält Input-Mapping/Bedingungs-
  /// relevante Vorschritt-Outputs fest, damit FollowUpResumeService die
  /// verbleibenden Schritte fortsetzen kann, ohne bereits ausgeführte
  /// Schritte erneut laufen zu lassen. Siehe docs/ORBIT_UNIFIED_EVOLUTION_CONCEPT.md §5.
  contextSnapshot      Json?          @map("context_snapshot")
  errorMessage         String?        @map("error_message")
  startedAt            DateTime       @default(now()) @map("started_at")
  completedAt          DateTime?      @map("completed_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  case               Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  stepRuns           WorkflowStepRun[]
  intakeEvents       IntakeEvent[]

  @@index([tenantId, status])
  @@map("workflow_runs")
}

/// Verknüpft einen ausgeführten Schritt mit dem AgentRun, den er erzeugt
/// hat — kein Duplikat der AgentRun/ToolInvocation-Daten, nur eine
/// Zuordnungstabelle. `agentRunId` fehlt bei einem übersprungenen
/// Schritt (`skipped: true`, Bedingung nicht erfüllt).
model WorkflowStepRun {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  workflowRunId  String                @map("workflow_run_id")
  stepOrder      Int                   @map("step_order")
  agentRunId     String?               @map("agent_run_id")
  skipped        Boolean               @default(false)
  /// Tatsächliches Ergebnis des Schritts (siehe WorkflowStepRunStatus). Ein zurückgegebener Tool-Fehler macht den Schritt FAILED, auch wenn keine Exception flog.
  status         WorkflowStepRunStatus @default(SUCCEEDED)
  attempt        Int                   @default(1)
  /// Sicherer, maschinenlesbarer Fehlercode (z. B. TOOL_RETURNED_ERROR, POLICY_BLOCKED) — nie eine rohe Provider-Meldung.
  errorCode      String?               @map("error_code")
  errorMessage   String?               @map("error_message")
  /// Name des Tools, dessen Ergebnis den Schritt scheitern ließ (Nachvollziehbarkeit Tool → StepRun).
  failedToolName String?               @map("failed_tool_name")
  createdAt      DateTime              @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agentRun    AgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([workflowRunId])
  @@index([agentRunId])
  @@map("workflow_step_runs")
}

// ============================================================================
// Webhook-Idempotenz (vorbereitet für künftige echte Connector-Webhooks —
// aktuell existiert kein einziger echter Webhook-Empfänger, jeder Connector
// ist noch ein Mock, siehe docs/INTEGRATIONS.md; die Endpoint-Seite kommt
// erst mit dem ersten echten Provider)
// ============================================================================

/// Jede erfolgreich verarbeitete Webhook-Zustellung, zur Duplikaterkennung
/// bei erneuter Zustellung desselben Ereignisses (fast jeder Webhook-Anbieter
/// garantiert nur "at-least-once", nie "exactly-once"). Der eindeutige Index
/// auf (tenantId, source, externalEventId) macht die Prüfung atomar und
/// race-sicher — WebhookIdempotencyService.recordIfNew() (apps/api) verlässt
/// sich auf den daraus resultierenden Datenbankfehler bei Duplikaten, statt
/// selbst "erst lesen, dann schreiben" zu machen (klassische TOCTOU-Lücke
/// bei parallelen Zustellungen desselben Ereignisses).
model WebhookEvent {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  /// Provider-Name, analog zu den *_CONNECTOR-Werten (@orbit/config/env.ts), z. B. "microsoft", "hubspot", "twilio".
  source          String
  /// Die vom Provider selbst vergebene Ereignis-/Nachrichten-ID.
  externalEventId String   @map("external_event_id")
  receivedAt      DateTime @default(now()) @map("received_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalEventId])
  @@index([tenantId, receivedAt])
  @@map("webhook_events")
}

// ============================================================================
// Retention-Grundlage (docs/ORBIT_UNIFIED_IMPLEMENTATION_PLAN.md Phase 2,
// docs/ORBIT_UNIFIED_EVOLUTION_CONCEPT.md §66) — bewusst nur die zwei
// operativen/Debug-Datenkategorien, nicht Audit-/Finanzdaten (die keiner
// rein technischen Aufbewahrungsentscheidung unterliegen sollten, siehe
// RetentionCategory-Kommentar). Kein automatischer Lösch-Scheduler in
// dieser Phase — nur die konfigurierbare Grundlage + eine manuell
// ausgelöste Anwendung, siehe RetentionService (apps/api).
// ============================================================================

/// Bewusst nur diese zwei Kategorien: reine Betriebs-/Debug-Daten ohne
/// gesetzliche Mindestaufbewahrungspflicht. Rechnungs-/Buchungsdaten,
/// Audit-Log, Nutzerkonten etc. sind hier absichtlich NICHT wählbar — für
/// die würde "wie lange aufbewahren" eine echte rechtliche Prüfung
/// brauchen, keine rein technische Entscheidung (§66 des Konzepts warnt
/// selbst davor: "Do not apply simplistic deletion to legally relevant
/// finance records").
enum RetentionCategory {
  /// AgentRun-Zeilen (+ per Kaskade deren ToolInvocation-Kindzeilen).
  AGENT_RUNS
  /// ToolInvocation-Zeilen einzeln, unabhängig vom Elternteil-AgentRun —
  /// z. B. um Tool-Ein-/Ausgabe-Nutzlasten (potenziell sensiblere Detail-
  /// daten) früher zu löschen als den bloßen Nachweis, dass ein Agentenlauf
  /// stattfand.
  TOOL_INVOCATIONS
}

/// Pro Tenant und Kategorie konfigurierbar. **Keine Zeile = unbegrenzte
/// Aufbewahrung** (sicherer Standard) — ein Tenant muss aktiv eine Police
/// anlegen, bevor überhaupt etwas als löschbar gilt. Wird nicht bei
/// `TenantsService.bootstrapTenant()` vorbefüllt (anders als
/// `PolicyConfig`), genau aus diesem Grund.
model RetentionPolicy {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  category        RetentionCategory
  retentionDays   Int               @map("retention_days")
  updatedByUserId String?           @map("updated_by_user_id")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@map("retention_policies")
}

// ============================================================================
// Test-/Mock-System-of-Record (Amendment 02 §10, §12.5)
// ============================================================================

enum MockCrmRecordKind {
  CONTACT
  COMPANY
  LEAD
  ACTIVITY
}

/// Dauerhafte, tenantgebundene Datensätze des Mock-CRM (`CRM_CONNECTOR=mock`). Ersetzt den reinen
/// Arbeitsspeicher-Zustand von `MockCrmConnector`: in Postgres gespeicherte `crmExternalId`-Referenzen
/// bleiben über Worker-/Container-Neustarts hinweg gültig und werden bei jedem Zugriff gegen diese
/// Tabelle (inkl. Mandantenbindung durch RLS) geprüft — eine formal ähnlich aussehende ID genügt nie.
model MockCrmRecord {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  kind       MockCrmRecordKind
  externalId String            @map("external_id")
  /// Abgleichsschlüssel für Upserts: E-Mail (CONTACT) bzw. Domain (COMPANY).
  matchKey   String?           @map("match_key")
  data       Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, externalId])
  @@index([tenantId, kind, matchKey])
  @@map("mock_crm_records")
}

// ============================================================================
// Business Process Framework — Intake Decision (Amendment 02 §5, §6, §19)
// ============================================================================

enum IntakeDecisionStatus {
  /// Triage lieferte ein gültiges, schema-validiertes Ergebnis.
  DECIDED
  /// Provider nicht verfügbar / Ausgabe auch nach Repair ungültig — wird erneut versucht, nichts geht verloren.
  PENDING_TRIAGE
  /// Menschliche Entscheidung nötig (Unsicherheit oder Simulation ohne Fixture).
  REVIEW_REQUIRED
  /// Ein berechtigter Mensch hat die Entscheidung auditiert korrigiert.
  OVERRIDDEN
}

/// Die dokumentierte Relevanz-/Zielentscheidung zu genau einem Eingang. Eigenständig von einem Business-Case:
/// ein sicher nicht geschäftsrelevanter Eingang erzeugt nur diese Entscheidung (Testbereich „Kein Geschäftsprozess
/// ausgelöst"), niemals einen künstlich abgeschlossenen Case.
model IntakeDecision {
  id                String               @id @default(uuid())
  tenantId          String               @map("tenant_id")
  intakeEventId     String               @unique @map("intake_event_id")
  status            IntakeDecisionStatus
  /// Validiertes TriageResult (siehe @orbit/shared process-schemas) — null solange keine gültige Triage vorliegt.
  result            Json?
  /// Aus dem Ergebnis abgeleitete, deterministisch durchgesetzte Relevanz (Konfidenz-Schwelle angewandt).
  appliedRelevance  IntakeRelevance?     @map("applied_relevance")
  failureReason     String?              @map("failure_reason")
  /// Provider, Modell, LIVE/SIMULATED, Laufzeit, Versuche — nie Secrets.
  execution         Json?
  /// Rein deterministische Hinweise (Header, Muster); sie entscheiden nie, sie informieren nur.
  hints             Json?
  retryCount        Int                  @default(0) @map("retry_count")
  nextRetryAt       DateTime?            @map("next_retry_at")
  reviewedByUserId  String?              @map("reviewed_by_user_id")
  reviewedAt        DateTime?            @map("reviewed_at")
  reviewNote        String?              @map("review_note")
  previousRelevance IntakeRelevance?     @map("previous_relevance")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intakeEvent IntakeEvent @relation(fields: [intakeEventId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, appliedRelevance])
  @@map("intake_decisions")
}

// ============================================================================
// Business Process Framework: Universal Case, Facts, Correlation (Amendment 02 §7, §12, §13)
// ============================================================================

/// §12.1 Prozesszustand eines Cases. Mapping auf `CaseStatus` über `caseStatusFor()` (@orbit/shared).
enum CaseOrchestrationStatus {
  RECEIVED
  READY
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  WAITING_FOR_APPROVAL
  WAITING_FOR_EXTERNAL_SYSTEM
  PAUSED
  MANUAL_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum CaseFactStatus {
  CANDIDATE
  CONFIRMED
  CONFLICTED
  STALE
  REJECTED
}

enum CaseFactSourceType {
  EMAIL
  ATTACHMENT
  SYSTEM_OF_RECORD
  CONFIGURATION
  HUMAN
}

/// §7.2 Ein Fakt mit Herkunft. Append-only: eine Änderung legt eine neue Zeile an (`revision` + `supersedesFactId`),
/// die alte bleibt als Historie erhalten (`isCurrent=false`). Widersprüchliche aktuelle Werte zu einem Schlüssel
/// stehen gemeinsam auf CONFLICTED, bis ein Mensch auflöst; der letzte Eingang gewinnt nie stillschweigend.
model CaseFact {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  caseId           String             @map("case_id")
  key              String
  value            Json
  valueSchemaRef   String?            @map("value_schema_ref")
  unit             String?
  currency         String?
  status           CaseFactStatus
  sourceType       CaseFactSourceType @map("source_type")
  sourceRef        String?            @map("source_ref")
  evidenceRefs     String[]           @default([]) @map("evidence_refs")
  observedAt       DateTime           @default(now()) @map("observed_at")
  validAsOf        DateTime?          @map("valid_as_of")
  expiresAt        DateTime?          @map("expires_at")
  confidence       Float?
  /// Wer oder was den Fakt bestätigt hat (Benutzer-ID, `schema`, `system-of-record`).
  verifiedBy       String?            @map("verified_by")
  revision         Int                @default(1)
  supersedesFactId String?            @map("supersedes_fact_id")
  isCurrent        Boolean            @default(true) @map("is_current")
  sensitivity      String?
  retentionClass   String?            @map("retention_class")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId, key, isCurrent])
  @@index([caseId, isCurrent])
  @@map("case_facts")
}

enum CaseCorrelationStatus {
  MATCHED
  AMBIGUOUS
  NONE
  OVERRIDDEN
}

/// §13.1 Wie ein Eingang einem Case zugeordnet wurde oder warum nicht: angewandte Regel, Kandidaten, Status.
/// Betreff oder Absenderadresse allein reichen nie für ein automatisches Zusammenführen.
model CaseCorrelation {
  id               String                @id @default(uuid())
  tenantId         String                @map("tenant_id")
  emailMessageId   String                @unique @map("email_message_id")
  caseId           String?               @map("case_id")
  status           CaseCorrelationStatus
  /// z. B. IN_REPLY_TO, REFERENCES, PROVIDER_THREAD, SEMANTIC_SUGGESTION, NONE
  rule             String
  candidateCaseIds String[]              @default([]) @map("candidate_case_ids")
  note             String?
  createdAt        DateTime              @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([tenantId, caseId])
  @@map("case_correlations")
}

// ============================================================================
// Amendment 02 - Business Process Framework: Blueprint-Registry, Plaene, Ledger, Events (BP-2b)
// ============================================================================

enum ProcessBlueprintStatus {
  DRAFT
  VALIDATING
  TESTING
  STAGED
  PUBLISHED
  SUSPENDED
  DEPRECATED
  ARCHIVED
}

enum ProcessPlanStatus {
  PROPOSED
  VALIDATED
  AWAITING_APPROVAL
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum ProcessPlanSource {
  BLUEPRINT_INSTANTIATION
  LLM_PLANNER
  HUMAN
}

enum ProcessNodeState {
  PLANNED
  READY
  RUNNING
  WAITING
  AWAITING_APPROVAL
  SUCCEEDED
  SKIPPED
  BLOCKED
  FAILED
  CANCELLED
  SUPERSEDED
  OUTCOME_UNKNOWN
}

enum ActionIntentStatus {
  PREPARED
  AWAITING_APPROVAL
  APPROVED
  DISPATCHING
  CONFIRMED
  FAILED
  OUTCOME_UNKNOWN
  CANCELLED
}

enum ActionReceiptStatus {
  CONFIRMED
  FAILED
  OUTCOME_UNKNOWN
}

enum WaitSubscriptionStatus {
  WAITING
  SATISFIED
  TIMED_OUT
  CANCELLED
}

enum CaseCommandStatus {
  ACCEPTED
  REJECTED
  CONFLICT
}

/// Section 8: versionierter Prozess-Blueprint (mandantenbezogen). Eine veroeffentlichte Version ist unveraenderlich (`definitionHash`).
model ProcessBlueprint {
  id              String                 @id @default(uuid())
  tenantId        String                 @map("tenant_id")
  key             String
  version         String
  status          ProcessBlueprintStatus @default(DRAFT)
  definition      Json
  definitionHash  String                 @map("definition_hash")
  /// Letztes Validierungsergebnis (Befunde), nur zur Anzeige.
  validation      Json?
  createdByUserId String?                @map("created_by_user_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  publishedAt     DateTime?              @map("published_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, version])
  @@index([tenantId, status])
  @@map("process_blueprints")
}

/// Section 8.2 Mandantenaktivierung: welche veroeffentlichte Version eines Blueprints neue Cases tatsaechlich startet.
model TenantProcessActivation {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  blueprintKey      String   @map("blueprint_key")
  activeVersion     String   @map("active_version")
  enabled           Boolean  @default(true)
  activatedByUserId String?  @map("activated_by_user_id")
  activatedAt       DateTime @default(now()) @map("activated_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, blueprintKey])
  @@map("tenant_process_activations")
}

/// Section 11: konkreter Plan eines Cases; jede Revision ist unveraenderlich, Aenderungen erzeugen eine neue Revision (`parentPlanId`).
model ProcessPlan {
  id                     String            @id @default(uuid())
  tenantId               String            @map("tenant_id")
  caseId                 String            @map("case_id")
  revision               Int
  parentPlanId           String?           @map("parent_plan_id")
  status                 ProcessPlanStatus
  source                 ProcessPlanSource
  blueprintKey           String?           @map("blueprint_key")
  blueprintVersion       String?           @map("blueprint_version")
  goalKeys               String[]          @default([]) @map("goal_keys")
  basedOnCaseRevision    Int               @map("based_on_case_revision")
  explanation            String
  assumptions            Json              @default("[]")
  unresolvedRequirements String[]          @default([]) @map("unresolved_requirements")
  /// Hash ueber Knoten+Kanten; Freigaben binden an Plan-ID + Hash (Section 14.4).
  planHash               String            @map("plan_hash")
  /// Ergebnis des Plan-Validators (Befunde je Pruefung aus Section 11.3).
  validation             Json
  createdByUserId        String?           @map("created_by_user_id")
  approvalId             String?           @map("approval_id")
  /// Kompakter Planvergleich zur Vorgaengerrevision (Section 11.5).
  diffFromParent         Json?             @map("diff_from_parent")
  createdAt              DateTime          @default(now()) @map("created_at")
  activatedAt            DateTime?         @map("activated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nodes  ProcessPlanNode[]
  edges  ProcessPlanEdge[]

  @@unique([caseId, revision])
  @@index([tenantId, caseId, status])
  @@map("process_plans")
}

model ProcessPlanNode {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  planId        String           @map("plan_id")
  nodeKey       String           @map("node_key")
  type          String
  title         String
  /// Vollstaendige validierte Knotendefinition (PlanNode).
  definition    Json
  state         ProcessNodeState @default(PLANNED)
  attempts      Int              @default(0)
  output        Json?
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message")
  /// LIVE | SIMULATED - gilt fuer die tatsaechliche Ausfuehrung dieses Knotens (Section 16.6).
  executionMode String?          @map("execution_mode")
  agentRunId    String?          @map("agent_run_id")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  /// Fruehester Zeitpunkt der naechsten Wiederholung.
  retryAt       DateTime?        @map("retry_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   ProcessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, nodeKey])
  @@index([tenantId, state])
  @@map("process_plan_nodes")
}

model ProcessPlanEdge {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  planId    String  @map("plan_id")
  edgeKey   String  @map("edge_key")
  sourceKey String  @map("source_key")
  targetKey String  @map("target_key")
  label     String?
  condition Json?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   ProcessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, edgeKey])
  @@map("process_plan_edges")
}

/// Section 15 Action-Ledger: jede externe Wirkung wird VOR der Ausfuehrung mit stabilem Idempotenzschluessel persistiert.
model ActionIntent {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  caseId         String             @map("case_id")
  planId         String             @map("plan_id")
  planRevision   Int                @map("plan_revision")
  caseRevision   Int                @map("case_revision")
  nodeKey        String             @map("node_key")
  capabilityKey  String             @map("capability_key")
  purpose        String?
  payload        Json
  /// SHA-256 ueber die kanonische Nutzlast; eine Freigabe bindet daran (Section 14.4).
  payloadHash    String             @map("payload_hash")
  idempotencyKey String             @map("idempotency_key")
  status         ActionIntentStatus @default(PREPARED)
  approvalId     String?            @map("approval_id")
  errorCode      String?            @map("error_code")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  receipts ActionReceipt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, caseId, status])
  @@map("action_intents")
}

model ActionReceipt {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  intentId      String              @map("intent_id")
  status        ActionReceiptStatus
  /// z. B. Gmail-Message-ID/ThreadId; bei simulierten Wirkungen ist `executionMode` SIMULATED.
  providerRef   String?             @map("provider_ref")
  evidence      Json
  executionMode String              @map("execution_mode")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intent ActionIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([tenantId, intentId])
  @@map("action_receipts")
}

/// Section 13.2 wartet auf ein korreliertes Ereignis (z. B. Antwort im selben Thread); ueberlebt Neustarts.
model WaitSubscription {
  id                 String                 @id @default(uuid())
  tenantId           String                 @map("tenant_id")
  caseId             String                 @map("case_id")
  planId             String?                @map("plan_id")
  nodeKey            String?                @map("node_key")
  eventType          String                 @map("event_type")
  /// z. B. { providerThreadId, rfcMessageId } der ausgehenden Nachricht.
  correlation        Json
  status             WaitSubscriptionStatus @default(WAITING)
  deadlineAt         DateTime?              @map("deadline_at")
  satisfiedByEventId String?                @map("satisfied_by_event_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  resolvedAt         DateTime?              @map("resolved_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId, status])
  @@index([status, deadlineAt])
  @@map("wait_subscriptions")
}

/// Section 12.3 / 18 Ereignisprotokoll je Case: Inbox (eingehend, dedupliziert) und Outbox (Zustandsaenderung -> UI/SSE).
/// `sequence` ist je Case lueckenlos und dient dem SSE-Cursor.
model CaseEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  caseId      String    @map("case_id")
  sequence    Int
  type        String
  payload     Json
  /// Eindeutige Ereignis-ID zur Deduplizierung eingehender Ereignisse.
  dedupeKey   String?   @map("dedupe_key")
  /// true = Eingangsereignis (Inbox), false = Ausgangs-/Protokollereignis.
  inbound     Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, sequence])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, inbound, processedAt])
  @@map("case_events")
}

/// Section 14.5 / 21.2 jede menschliche Intervention ist ein validierter, idempotenter Command mit Versionsbindung.
model CaseCommand {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  caseId               String            @map("case_id")
  commandId            String            @map("command_id")
  type                 String
  payload              Json
  expectedCaseRevision Int               @map("expected_case_revision")
  status               CaseCommandStatus
  resultCaseRevision   Int?              @map("result_case_revision")
  actorUserId          String            @map("actor_user_id")
  errors               Json?
  createdAt            DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, commandId])
  @@index([tenantId, caseId])
  @@map("case_commands")
}

// ============================================================================
// Amendment 02 - Referenzprozess: Test-SoR, Entwuerfe, Angebote (BP-3)
// ============================================================================

enum CommunicationDraftStatus {
  DRAFT
  SUPERSEDED
  SENT
}

enum QuoteStatus {
  DRAFT
  RENDERED
  SENT
  SUPERSEDED
}

/// Kennzeichnet einen Test-/Referenzdatenbestand (`source`), der ueber dieselben Capability-Vertraege gelesen wird wie
/// spaetere echte Quellen. Daten kommen aus Fixtures/Seed bzw. Admin-Import - nie aus Engine-Code (Amendment 02, Abschnitt 0.2).
model ReferenceCatalogItem {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  sku        String
  name       String
  category   String
  unit       String
  unitPrice  Decimal   @map("unit_price") @db.Decimal(12, 2)
  currency   String    @default("EUR")
  taxRate    Decimal   @map("tax_rate") @db.Decimal(5, 2)
  /// Optionale Staffelpreise: [{ "minQuantity": 10, "unitPrice": 95.00 }].
  priceTiers Json?     @map("price_tiers")
  attributes Json?
  source     String    @default("TEST_SOR")
  active     Boolean   @default(true)
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@map("reference_catalog_items")
}

/// Welche zusaetzlichen Angaben fuer eine Leistungskategorie noetig sind (Daten, nicht Code).
model ReferenceRequirementRule {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  category   String
  factKey    String   @map("fact_key")
  valueType  String   @map("value_type")
  question   String
  orderIndex Int      @default(0) @map("order_index")
  source     String   @default("TEST_SOR")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category, factKey])
  @@map("reference_requirement_rules")
}

/// Unveraenderliche Version einer ausgehenden Nachricht. Jede Bearbeitung legt eine neue Version an; die Freigabe
/// bindet ueber `contentHash` an genau diesen Inhalt.
model CommunicationDraft {
  id                    String                   @id @default(uuid())
  tenantId              String                   @map("tenant_id")
  caseId                String                   @map("case_id")
  purpose               String
  version               Int
  parentDraftId         String?                  @map("parent_draft_id")
  toAddress             String                   @map("to_address")
  subject               String
  bodyText              String                   @map("body_text")
  attachmentDocumentIds String[]                 @default([]) @map("attachment_document_ids")
  contentHash           String                   @map("content_hash")
  /// Antwort im bestehenden Thread: Provider-Thread und RFC-Message-ID der Nachricht, auf die geantwortet wird.
  threadId              String?                  @map("thread_id")
  inReplyTo             String?                  @map("in_reply_to")
  status                CommunicationDraftStatus @default(DRAFT)
  createdByUserId       String?                  @map("created_by_user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, purpose, version])
  @@index([tenantId, caseId])
  @@map("communication_drafts")
}

/// Angebot. Die Nummer vergibt ein Nummerndienst (`TenantSequence`), nie die KI; Preise stammen aus einer Preisquelle.
model Quote {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  caseId      String      @map("case_id")
  number      String
  version     Int         @default(1)
  status      QuoteStatus @default(DRAFT)
  currency    String
  lines       Json
  netAmount   Decimal     @map("net_amount") @db.Decimal(12, 2)
  taxAmount   Decimal     @map("tax_amount") @db.Decimal(12, 2)
  grossAmount Decimal     @map("gross_amount") @db.Decimal(12, 2)
  validUntil  DateTime    @map("valid_until")
  /// Herkunft der Preise, z. B. "TEST_SOR:catalog@2026-10-04".
  priceSource String      @map("price_source")
  documentId  String?     @map("document_id")
  contentHash String      @map("content_hash")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number, version])
  @@index([tenantId, caseId])
  @@map("quotes")
}

model TenantSequence {
  tenantId  String @map("tenant_id")
  key       String
  nextValue Int    @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_sequences")
}

// ============================================================================
// ZERIONUS Platform Control Plane (Amendment 03) — Sicherheitsdomäne "Plattform"
// ============================================================================
// Bewusst OHNE tenant_id: Betreiberidentitäten gehören keinem Mandanten (ADR OPS-A1). Der Zugriff ist per Postgres-RLS an den
// Transaktions-GUC `app.platform_scope` gebunden, der ausschließlich der Plattform-Zugriffspfad setzt (PrismaService.withPlatformScope).

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

model PlatformUser {
  id                      String             @id @default(uuid())
  email                   String             @unique
  passwordHash            String             @map("password_hash")
  displayName             String             @map("display_name")
  status                  PlatformUserStatus @default(ACTIVE)
  lastLoginAt             DateTime?          @map("last_login_at")
  /// Nach Zurücksetzen oder Anlage mit Startpasswort: bis zum Wechsel sind nur Passwortwechsel, Abmelden und die eigene Kontoabfrage erlaubt.
  passwordChangeRequired  Boolean            @default(false) @map("password_change_required")
  createdByPlatformUserId String?            @map("created_by_platform_user_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  roleAssignments PlatformRoleAssignment[]
  sessions        PlatformSession[]

  @@map("platform_users")
}

/// Rolle als Name aus PLATFORM_ROLES (@orbit/shared/platform.ts); pro Nutzer höchstens eine aktive Zuweisung je Rolle (partieller Unique-Index in der Migration).
model PlatformRoleAssignment {
  id              String    @id @default(uuid())
  platformUserId  String    @map("platform_user_id")
  role            String
  grantedByUserId String?   @map("granted_by_user_id")
  grantedAt       DateTime  @default(now()) @map("granted_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id")

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_role_assignments")
}

model PlatformSession {
  id               String    @id @default(uuid())
  platformUserId   String    @map("platform_user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// 'PASSWORD' | 'PASSWORD_STEP_UP' | 'MFA' (MFA ist nur als Erweiterungsgrenze reserviert).
  assurance        String    @default("PASSWORD")
  stepUpUntil      DateTime? @map("step_up_until")
  environment      String
  /// Absolute Sitzungsgrenze: ein Refresh verlängert sie nie.
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_sessions")
}

// ============================================================================
// AI Platform Governance (Amendment 03 §8–§12) — Plattformdomäne, ohne tenant_id (Ausnahme: AIUsageRecord)
// ============================================================================

enum AIProviderLifecycle {
  DRAFT
  VALIDATING
  ACTIVE
  DEPRECATED
  SUSPENDED
  RETIRED
}

enum AIModelLifecycle {
  VALIDATING
  APPROVED
  DEPRECATED
  BLOCKED
  RETIRED
}

enum AIModelProfileLifecycle {
  DRAFT
  TESTING
  PUBLISHED
  DEPRECATED
}

enum AIFallbackMode {
  NO_FALLBACK
  SAME_PROVIDER_FALLBACK
  APPROVED_CROSS_PROVIDER_FALLBACK
}

enum AIConnectionLifecycle {
  CONFIGURING
  ACTIVE
  DEGRADED
  SUSPENDED
  REVOKED
}

enum AIHealthStatus {
  UP
  DEGRADED
  RATE_LIMITED
  DOWN
  DISABLED
  UNKNOWN
}

/// Welche Anbieter ORBIT unterstützt – unabhängig davon, ob ein SDK installiert ist (Amendment 03 §8.2).
model AIProviderDefinition {
  providerKey              String              @id @map("provider_key")
  displayName              String              @map("display_name")
  /// Schlüssel des Adapters im Code (openai, anthropic, mock, …); der Anbieter ist erst mit Lifecycle ACTIVE produktiv.
  adapterKey               String              @map("adapter_key")
  lifecycle                AIProviderLifecycle @default(DRAFT)
  supportedCredentialTypes String[]            @default([]) @map("supported_credential_types")
  supportedRegions         String[]            @default([]) @map("supported_regions")
  supportedCapabilities    String[]            @default([]) @map("supported_capabilities")
  dataPolicyRefs           String[]            @default([]) @map("data_policy_refs")
  version                  Int                 @default(1)
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  models      AIModelDefinition[]
  connections PlatformAIConnection[]

  @@map("ai_provider_definitions")
}

model AIModelDefinition {
  id                        String           @id @default(uuid())
  providerKey               String           @map("provider_key")
  providerModelId           String           @map("provider_model_id")
  displayName               String           @map("display_name")
  lifecycle                 AIModelLifecycle @default(VALIDATING)
  capabilityTags            String[]         @default([]) @map("capability_tags")
  contextLimit              Int?             @map("context_limit")
  toolUseSupported          Boolean          @default(false) @map("tool_use_supported")
  structuredOutputSupported Boolean          @default(false) @map("structured_output_supported")
  regionAvailability        String[]         @default([]) @map("region_availability")
  dataPolicyRefs            String[]         @default([]) @map("data_policy_refs")
  /// Kostenprofil je 1 Mio. Token (Währung in costCurrency); NULL = unbekannt (Kosten werden dann nicht geschätzt, nie erfunden).
  costInputPerMtok          Decimal?         @map("cost_input_per_mtok") @db.Decimal(14, 6)
  costOutputPerMtok         Decimal?         @map("cost_output_per_mtok") @db.Decimal(14, 6)
  costCurrency              String           @default("EUR") @map("cost_currency")
  /// NONE | PASSED | FAILED – Voraussetzung für die Freigabe (Amendment 03 §8.5).
  evaluationStatus          String           @default("NONE") @map("evaluation_status")
  approvedAt                DateTime?        @map("approved_at")
  deprecatedAt              DateTime?        @map("deprecated_at")
  version                   Int              @default(1)
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  provider AIProviderDefinition @relation(fields: [providerKey], references: [providerKey])
  routes   AIProviderRoute[]

  @@unique([providerKey, providerModelId])
  @@map("ai_model_definitions")
}

/// Versionierte logische Modellprofile; PUBLISHED-Versionen sind unveränderlich (Trigger in der Migration), Änderungen erzeugen eine neue Version.
model AIModelProfile {
  id                     String                  @id @default(uuid())
  profileKey             String                  @map("profile_key")
  version                Int
  purpose                String
  requiredCapabilities   String[]                @default([]) @map("required_capabilities")
  fallbackMode           AIFallbackMode          @default(NO_FALLBACK) @map("fallback_mode")
  maxLatencyMs           Int?                    @map("max_latency_ms")
  requiredDataPolicyRefs String[]                @default([]) @map("required_data_policy_refs")
  lifecycle              AIModelProfileLifecycle @default(DRAFT)
  publishedAt            DateTime?               @map("published_at")
  createdByUserId        String?                 @map("created_by_user_id")
  createdAt              DateTime                @default(now()) @map("created_at")

  @@unique([profileKey, version])
  @@map("ai_model_profiles")
}

/// Profil → Modell (Amendment 03 §11). Je (Profil, Umgebung, Mandantenscope) höchstens eine aktive Route (partieller Unique-Index).
model AIProviderRoute {
  id               String         @id @default(uuid())
  modelProfileKey  String         @map("model_profile_key")
  environment      String
  /// NULL = global; sonst die Mandanten-ID eines Mandanten-Overrides (bewusst ohne FK; verschwindet ein Mandant, wird die Route wirkungslos).
  tenantScope      String?        @map("tenant_scope")
  primaryModelId   String         @map("primary_model_id")
  fallbackModelIds String[]       @default([]) @map("fallback_model_ids")
  fallbackMode     AIFallbackMode @default(NO_FALLBACK) @map("fallback_mode")
  trafficPercent   Int            @default(100) @map("traffic_percent")
  active           Boolean        @default(false)
  activeFrom       DateTime?      @map("active_from")
  activeUntil      DateTime?      @map("active_until")
  policyVersion    String         @default("1") @map("policy_version")
  version          Int            @default(1)
  createdByUserId  String?        @map("created_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  primaryModel AIModelDefinition @relation(fields: [primaryModelId], references: [id])

  @@index([modelProfileKey, environment])
  @@map("ai_provider_routes")
}

/// ORBIT-Managed-Zugang je Anbieter/Umgebung. Das Secret liegt nie in dieser Tabelle, sondern hinter secretRef (vault:<id> oder env:<NAME>).
model PlatformAIConnection {
  id                 String                @id @default(uuid())
  providerKey        String                @map("provider_key")
  environment        String
  regionKey          String?               @map("region_key")
  credentialType     String                @default("API_KEY") @map("credential_type")
  secretRef          String                @map("secret_ref")
  lifecycle          AIConnectionLifecycle @default(CONFIGURING)
  lastValidatedAt    DateTime?             @map("last_validated_at")
  lastHealthStatus   String?               @map("last_health_status")
  allowedProfileKeys String[]              @default([]) @map("allowed_profile_keys")
  version            Int                   @default(1)
  createdByUserId    String?               @map("created_by_user_id")
  updatedByUserId    String?               @map("updated_by_user_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  provider AIProviderDefinition @relation(fields: [providerKey], references: [providerKey])

  @@unique([providerKey, environment])
  @@map("platform_ai_connections")
}

/// Aktueller Gesundheitszustand je Anbieter/Modell/Umgebung (Amendment 03 §12.1), gespeist aus echten Aufrufen und aktiven Prüfungen.
model AIProviderHealth {
  id                  String         @id @default(uuid())
  providerKey         String         @map("provider_key")
  /// * = gesamter Anbieter, sonst die Modell-ID des Anbieters.
  modelRef            String         @default("*") @map("model_ref")
  environment         String
  status              AIHealthStatus @default(UNKNOWN)
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime?      @map("last_success_at")
  lastFailureAt       DateTime?      @map("last_failure_at")
  lastErrorClass      String?        @map("last_error_class")
  avgLatencyMs        Int?           @map("avg_latency_ms")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@unique([providerKey, modelRef, environment])
  @@map("ai_provider_health")
}

/// Nutzung je Aufruf (Amendment 03 §12.2). Mandantengebunden (RLS) und für die Plattform-FinOps im Plattform-Scope lesbar. Kein Prompt-/Antwortinhalt.
/// Kosten-Leitplanken (Amendment 03 §12.3): Plattformtabelle ohne tenant_id (die Mandanten-ID ist ein Verweis, kein Besitz), RLS über app.platform_scope.
model AICostLimit {
  id              String   @id @default(uuid())
  /// GLOBAL | TENANT | PROFILE – höchstens ein Limit je Bereich (`scopeKey`).
  scope           String
  scopeKey        String   @unique @map("scope_key")
  targetTenantId  String?  @map("target_tenant_id")
  profileKey      String?  @map("profile_key")
  currency        String   @default("USD")
  warnAmount      Decimal? @map("warn_amount") @db.Decimal(14, 2)
  softAmount      Decimal? @map("soft_amount") @db.Decimal(14, 2)
  hardAmount      Decimal? @map("hard_amount") @db.Decimal(14, 2)
  hardEnforced    Boolean  @default(false) @map("hard_enforced")
  version         Int      @default(1)
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_cost_limits")
}

model AIUsageRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  profileKey    String   @map("profile_key")
  providerKey   String   @map("provider_key")
  modelId       String?  @map("model_id")
  routeId       String?  @map("route_id")
  environment   String
  /// ORBIT_MANAGED | BYOK | ENV_BOOTSTRAP
  source        String
  status        String
  errorClass    String?  @map("error_class")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(14, 6)
  costCurrency  String?  @map("cost_currency")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([profileKey, createdAt])
  @@index([providerKey, createdAt])
  @@map("ai_usage_records")
}

/// Verschlüsselte Plattform-Secrets (Amendment 03 §20). Nie im Klartext zurückgegeben; Zugriff nur über PlatformSecretVaultService.
model PlatformSecret {
  id              String   @id @default(uuid())
  encryptedValue  Bytes    @map("encrypted_value")
  version         Int      @default(1)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_secrets")
}

// ============================================================================
// Plattformsteuerung (Amendment 03 §13–§15): Feature Flags, Kill Switches, Connector-Lifecycle
// ============================================================================

enum PlatformFlagLifecycle {
  DRAFT
  ACTIVE
  EXPIRED
  RETIRED
}

enum PlatformConnectorLifecycle {
  DRAFT
  TESTING
  ACTIVE
  DEPRECATED
  SUSPENDED
  RETIRED
}

model PlatformFeatureFlag {
  id                   String                @id @default(uuid())
  key                  String                @unique
  description          String
  lifecycle            PlatformFlagLifecycle @default(DRAFT)
  defaultValue         Json                  @map("default_value")
  environmentOverrides Json                  @default("[]") @map("environment_overrides")
  cohortOverrides      Json                  @default("[]") @map("cohort_overrides")
  tenantOverrides      Json                  @default("[]") @map("tenant_overrides")
  owner                String
  expiresAt            DateTime?             @map("expires_at")
  exposeToTenant       Boolean               @default(false) @map("expose_to_tenant")
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("platform_feature_flags")
}

model PlatformKillSwitch {
  id              String    @id @default(uuid())
  key             String    @unique
  engaged         Boolean   @default(false)
  reason          String?
  changedByUserId String?   @map("changed_by_user_id")
  changedAt       DateTime? @map("changed_at")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("platform_kill_switches")
}

/// Governance-Overlay auf dem einen Connector-Katalog (integration-core CONNECTOR_REGISTRY). Ohne Zeile gilt ACTIVE.
model PlatformConnectorDefinition {
  id              String                     @id @default(uuid())
  connectorKey    String                     @unique @map("connector_key")
  lifecycle       PlatformConnectorLifecycle @default(ACTIVE)
  reason          String?
  dataPolicyRefs  String[]                   @default([]) @map("data_policy_refs")
  changedByUserId String?                    @map("changed_by_user_id")
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@map("platform_connector_definitions")
}

// ============================================================================
// Support-Sessions (Amendment 03 §18) — expliziter, zeitlich begrenzter, scopebasierter Zugriff; kein stilles Impersonation
// ============================================================================

enum PlatformSupportSessionStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  REVOKED
  CLOSED
}

model PlatformSupportSession {
  id               String                       @id @default(uuid())
  /// Verweis auf den Mandanten (kein FK: der Nachweis überlebt eine Mandantenlöschung).
  targetTenantId   String                       @map("target_tenant_id")
  operatorUserId   String                       @map("operator_user_id")
  reasonCode       String                       @map("reason_code")
  freeTextReason   String                       @map("free_text_reason")
  ticketRef        String?                      @map("ticket_ref")
  mode             String
  scopes           String[]                     @default([])
  requestedMinutes Int                          @map("requested_minutes")
  status           PlatformSupportSessionStatus @default(REQUESTED)
  approvedByUserId String?                      @map("approved_by_user_id")
  approvedAt       DateTime?                    @map("approved_at")
  activatedAt      DateTime?                    @map("activated_at")
  /// Wird bei Aktivierung gesetzt und nie verlängert (kein stilles Erneuern).
  expiresAt        DateTime?                    @map("expires_at")
  closedAt         DateTime?                    @map("closed_at")
  closedByUserId   String?                      @map("closed_by_user_id")
  closeReason      String?                      @map("close_reason")
  version          Int                          @default(1)
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  @@index([targetTenantId, status])
  @@index([operatorUserId, status])
  @@map("platform_support_sessions")
}

// ============================================================================
// Betriebsprofil und Mitarbeiterverzeichnis (Rückmeldung: „ORBIT muss wissen, wie der Betrieb arbeitet und wen es wie erreicht“)
// ============================================================================

/// Wie sich ein Mitarbeiter am besten erreichen lässt. Zustellung: E-Mail ist angebunden; Teams/WhatsApp/SMS/Telefon sind erfasst und werden – solange kein
/// Anbieter verbunden ist – ehrlich über E-Mail zugestellt (siehe docs/ASSUMPTIONS.md).
enum StaffContactChannel {
  EMAIL
  TEAMS
  WHATSAPP
  SMS
  PHONE
}

/// Rolle im Unternehmen (grob, für Zuständigkeiten und Eskalation); die genaue Funktion steht in `roleTitle`.
enum StaffRoleKind {
  OWNER
  MANAGER
  DISPATCHER
  TECHNICIAN
  OFFICE
  ACCOUNTING
  SALES
  OTHER
}

/// „Wie dieser Betrieb arbeitet“: Branche, Leistungen, Einsatzgebiet, Zeiten, Notdienst, Tonalität, häufige Fragen. Grundlage für die KI-Entscheidungen im Sinne des Unternehmens.
model TenantProfile {
  id                    String    @id @default(uuid())
  tenantId              String    @unique @map("tenant_id")
  /// Branche bzw. Gewerk in Worten (z. B. „Heizung und Sanitär“, „Dachdecker“, „KFZ-Werkstatt“).
  industry              String?
  /// Was der Betrieb macht, in wenigen Sätzen.
  description           String?
  services              String[]  @default([])
  /// Was der Betrieb ausdrücklich nicht anbietet.
  exclusions            String[]  @default([])
  serviceArea           String?   @map("service_area")
  /// [{ days: ['MON'..'SUN'], from: 'HH:mm', to: 'HH:mm' }]
  openingHours          Json?     @map("opening_hours")
  emergencyService      Boolean   @default(false) @map("emergency_service")
  emergencyNote         String?   @map("emergency_note")
  /// FORMAL | FRIENDLY
  tone                  String    @default("FORMAL")
  /// Sprachen, in denen der Betrieb antworten kann (ISO-639-1); die Antwort richtet sich nach der Sprache der Kundschaft, sonst nach der ersten Sprache.
  languages             String[]  @default(["de"])
  /// [{ question, answer }]
  faqs                  Json?
  /// Wann ORBIT erinnert und eskaliert: { reminderAfterMinutes, escalateAfterMinutes, emergencyReminderMinutes, emergencyEscalateMinutes } (Standard im Code).
  escalationPolicy      Json?     @map("escalation_policy")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// Wann der Automatisierungsgrad bewusst gewählt (oder bei der Anlage des Betriebs festgelegt) wurde.
  automationConfirmedAt DateTime? @map("automation_confirmed_at")
  updatedByUserId       String?   @map("updated_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

/// Eine Person des Betriebs mit Rolle, Zuständigkeiten und Erreichbarkeit. Nicht jede Person nutzt ORBIT (z. B. Monteure): `userId` verknüpft optional.
model StaffMember {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  /// Kennung im führenden System (Personalnummer, ID aus dem Verzeichnis) – Schlüssel für den Abgleich (CSV/API).
  externalId       String?             @map("external_id")
  firstName        String              @map("first_name")
  lastName         String              @map("last_name")
  roleKind         StaffRoleKind       @default(OTHER) @map("role_kind")
  roleTitle        String?             @map("role_title")
  email            String?
  /// Mobilnummer für Anruf/SMS/WhatsApp.
  phone            String?
  teamsAddress     String?             @map("teams_address")
  whatsappNumber   String?             @map("whatsapp_number")
  preferredChannel StaffContactChannel @default(EMAIL) @map("preferred_channel")
  /// EMERGENCY, QUOTES, INVOICES, APPLICATIONS, COMPLAINTS, APPOINTMENTS, GENERAL – wen ORBIT wofür informiert.
  responsibilities String[]            @default([])
  /// Google-Kalender-ID für die Verfügbarkeit bei Terminvorschlägen (z. B. Monteure).
  calendarId       String?             @map("calendar_id")
  availabilityNote String?             @map("availability_note")
  userId           String?             @map("user_id")
  /// Vorgesetzte Person: wird informiert, wenn die zuständige Person nicht reagiert (Eskalation).
  supervisorId     String?             @map("supervisor_id")
  /// Vertretung bei Krankheit/Urlaub: wird zuerst informiert, wenn die zuständige Person nicht reagiert.
  deputyId         String?             @map("deputy_id")
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications StaffNotification[]

  @@unique([tenantId, externalId])
  @@index([tenantId, active])
  @@map("staff_members")
}

/// Ein Vorgang, der auf einen Menschen wartet (Prüfung, Freigabe, Fehler, Notfall) – und wie weit die Benachrichtigung und Eskalation gediehen ist.
/// Zustandsbasiert: der Abgleich legt den Eintrag an, solange der Vorgang im wartenden Zustand ist, und löst ihn, sobald er ihn verlässt.
model AttentionItem {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  caseId               String    @map("case_id")
  /// MANUAL_REVIEW | WAITING_FOR_APPROVAL | FAILED | EMERGENCY
  kind                 String
  /// Zuständigkeit (StaffResponsibility), nach der die Adressaten bestimmt wurden.
  responsibility       String
  emergency            Boolean   @default(false)
  reason               String?
  /// OPEN | ACKNOWLEDGED (jemand hat übernommen: keine Erinnerungen mehr) | SUPPRESSED (Altbestand beim Einschalten, es wird niemand benachrichtigt) | RESOLVED
  state                String    @default("OPEN")
  /// Zuletzt erreichte Phase: INITIAL | REMINDER | ESCALATED
  phase                String    @default("INITIAL")
  firstSeenAt          DateTime  @default(now()) @map("first_seen_at")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  resolvedAt           DateTime? @map("resolved_at")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  acknowledgedByUserId String?   @map("acknowledged_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case          Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notifications StaffNotification[]

  @@index([tenantId, state])
  @@index([caseId])
  @@map("attention_items")
}

/// Eine Meldung an eine Person des Betriebs – mit dem gewünschten und dem tatsächlich genutzten Kanal (kein stilles Umlenken).
model StaffNotification {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  attentionItemId String   @map("attention_item_id")
  staffMemberId   String   @map("staff_member_id")
  phase           String
  /// RESPONSIBLE | DEPUTY | SUPERVISOR | LEADERSHIP
  role            String
  subject         String
  wantedChannel   String   @map("wanted_channel")
  deliveredVia    String?  @map("delivered_via")
  /// SENT | FAILED | SKIPPED
  status          String
  /// LIVE | SIMULATED
  executionMode   String?  @map("execution_mode")
  note            String?
  error           String?
  /// Bei fehlgeschlagener Zustellung: wie oft versucht wurde (Wiederholung im Abstand, begrenzt).
  attempts        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attentionItem AttentionItem @relation(fields: [attentionItemId], references: [id], onDelete: Cascade)
  staffMember   StaffMember   @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([attentionItemId, staffMemberId, phase])
  @@index([tenantId, createdAt])
  @@map("staff_notifications")
}
