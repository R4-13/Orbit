# Einstellungen des Kunden-Simulators. Kopieren nach `.env.local` (diese Datei wird nicht eingecheckt) und ausfüllen.

# Google-OAuth-Client. Am einfachsten ein eigener Client vom Typ „Desktop-App“ (Google Cloud Console → APIs & Dienste → Anmeldedaten); dann ist keine
# Weiterleitungs-URI einzutragen. Alternativ der Web-Client von ORBIT – dann muss http://127.0.0.1:8765 als Weiterleitungs-URI eingetragen sein.
SIM_GOOGLE_CLIENT_ID=""
SIM_GOOGLE_CLIENT_SECRET=""

# Das Konto von „Tom“ (Absender) und die einzigen erlaubten Empfänger (mehrere mit Komma). Alles andere wird abgelehnt.
SIM_FROM="tomorbit777@gmail.com"
SIM_FROM_NAME="Tom Orbit"
SIM_ALLOWED_RECIPIENTS="handwerkernull@gmail.com"

# Obergrenzen (Vorgaben: 20 je Stunde, 100 je 24 Stunden) und das Etikett, mit dem gesendete Mails in Toms Postfach markiert werden.
SIM_MAX_PER_HOUR=20
SIM_MAX_PER_DAY=100
SIM_LABEL="ORBIT-Simulation"

# Wird von „node simulator.mjs auth“ eingetragen – nicht von Hand.
SIM_REFRESH_TOKEN=""
