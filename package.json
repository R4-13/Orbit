{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Project ORBIT - Multi-Tenant B2B SaaS Automation Platform (Finance & Sales)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma:generate": "pnpm --filter @orbit/domain prisma:generate",
    "prisma:migrate": "pnpm --filter @orbit/domain prisma:migrate",
    "prisma:deploy": "pnpm --filter @orbit/domain prisma:deploy",
    "prisma:seed": "pnpm --filter @orbit/domain prisma:seed",
    "db:reset": "pnpm --filter @orbit/domain prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.71.2",
    "globals": "^15.14.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "lodash": "^4.18.1",
      "js-yaml@>=4": "^4.3.2",
      "glob@^10": "^10.5.0",
      "sharp": "^0.35.5",
      "qs": "^6.16.0",
      "body-parser": "^1.20.6",
      "next>postcss": "^8.5.23",
      "source-map-js": "^1.2.2"
    }
  }
}
