{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Project ORBIT - Multi-Tenant B2B SaaS Automation Platform (Finance & Sales)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma:generate": "pnpm --filter @orbit/domain prisma:generate",
    "prisma:migrate": "pnpm --filter @orbit/domain prisma:migrate",
    "prisma:deploy": "pnpm --filter @orbit/domain prisma:deploy",
    "prisma:seed": "pnpm --filter @orbit/domain prisma:seed",
    "db:reset": "pnpm --filter @orbit/domain prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "globals": "^15.14.0"
  }
}
