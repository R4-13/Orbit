{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 20000,
  "setupFiles": [
    "<rootDir>/utils/e2e-env.ts"
  ],
  "globalSetup": "<rootDir>/utils/global-setup.ts",
  "globalTeardown": "<rootDir>/utils/global-teardown.ts"
}
