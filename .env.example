# =============================================================================
# Project ORBIT — Environment Configuration
# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. Secrets shown here are placeholders only.
# =============================================================================

# --- Branding (configurable, no product name hard-coded anywhere else) -----
APP_NAME="Project ORBIT"
BRAND_NAME="Project ORBIT"
BRAND_LOGO="/branding/logo.svg"
PRIMARY_DOMAIN="orbit.local"
SUPPORT_EMAIL="support@orbit.local"

# --- Core ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
DEFAULT_LOCALE=de-DE
SUPPORTED_LOCALES=de-DE,en-US

# --- Database (PostgreSQL) ------------------------------------------------
# DATABASE_URL: used by the Prisma CLI (migrate/generate/seed) and owns the
# schema — a superuser in local/CI Postgres images, which is why it must
# NEVER be the connection the running app uses (superusers unconditionally
# bypass Row-Level Security, see docs/ASSUMPTIONS.md Phase 15).
DATABASE_URL="postgresql://orbit:orbit_local_dev@localhost:5432/orbit?schema=public"
# DATABASE_URL_APP: what apps/api actually connects with at runtime — the
# restricted, non-superuser "orbit_app" role created by
# docker/postgres/10-init-app-role.sh, so Postgres RLS policies actually
# apply. Password here must match DATABASE_APP_PASSWORD in docker-compose*.yml.
DATABASE_URL_APP="postgresql://orbit_app:orbit_app_local_dev@localhost:5432/orbit?schema=public&connection_limit=20"
# DATABASE_APP_PASSWORD: the same password, alone — used by docker-compose*.yml
# to both provision the "orbit_app" role (docker/postgres/10-init-app-role.sh)
# and build the api/worker containers' own DATABASE_URL_APP, via compose's
# `${VAR}` substitution from this file.
DATABASE_APP_PASSWORD="orbit_app_local_dev"

# --- Redis / Queue (BullMQ) ------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Object Storage (S3-compatible, MinIO locally) -------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_BUCKET="orbit-documents"
S3_ACCESS_KEY="orbit_minio_admin"
S3_SECRET_KEY="orbit_minio_admin_secret_change_me"
S3_FORCE_PATH_STYLE=true
# Optional: the browser-reachable endpoint for presigned URLs, if different from
# S3_ENDPOINT (docker-compose.yml sets this to "http://localhost:9000" for the api
# service, since S3_ENDPOINT there is the Docker-internal "http://minio:9000" the
# browser cannot resolve). Leave unset here — on the host, both are the same.
# S3_PUBLIC_ENDPOINT="http://localhost:9000"
# Server-side upload limits, enforced before a presigned URL is issued (docs/SECURITY.md §5).
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_UPLOAD_MIME_TYPES="application/pdf,image/png,image/jpeg,image/tiff,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"

# --- Auth / Security --------------------------------------------------
JWT_SECRET="change_me_dev_only_use_a_long_random_string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ZERIONUS Platform Control Plane (Amendment 03): eigene Sicherheitsdomäne mit EIGENEM Token-Secret (muss sich von JWT_SECRET unterscheiden, >= 32 Zeichen).
# Ohne PLATFORM_JWT_SECRET ist die Plattformdomäne ausgeschaltet (Routen antworten 503). Erste Identität: apps/api/scripts/platform-bootstrap.ts
PLATFORM_JWT_SECRET=""
PLATFORM_ACCESS_TTL="15m"
PLATFORM_SESSION_MAX_HOURS="8"
PLATFORM_STEP_UP_MINUTES="5"
# development | test | staging | production — unbekannte Werte gelten nie als production
ORBIT_ENVIRONMENT="development"
# 32-byte (256-bit) key, base64-encoded, used for AES-256-GCM credential encryption.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32BYTE_KEY"
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- AI Provider Layer (platform-managed default, §35 des Unified-Evolution-
# Konzepts) -------------------------------------------------------------
# "anthropic", "openai" or "mock". Business logic never calls a provider SDK
# directly. A tenant's own BYOK override (Admin > AI-Provider) is stored
# encrypted per-tenant, not via env vars — see apps/api/src/ai-providers/.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Optional: reasoning models (z. B. gpt-6-luna) akzeptieren Function-Tools über Chat Completions nur mit "none".
# OPENAI_REASONING_EFFORT=none

# --- OCR Provider ------------------------------------------------------
# "mock" or "tesseract" (local, pluggable — see docs/INTEGRATIONS.md)
OCR_PROVIDER=mock

# --- Speech-to-Text Provider --------------------------------------------
STT_PROVIDER=mock

# --- Feature Flags: Finance Connectors ----------------------------------
FINANCE_CONNECTOR=mock
# DATEV (requires DATEV partner/OAuth registration — see docs/DATEV_INTEGRATION.md)
DATEV_CLIENT_ID=""
DATEV_CLIENT_SECRET=""
DATEV_ENVIRONMENT="sandbox"
DATEV_REDIRECT_URI=""
# Lexware Office (requires OAuth app registration — see docs/INTEGRATIONS.md)
LEXWARE_CLIENT_ID=""
LEXWARE_CLIENT_SECRET=""
LEXWARE_REDIRECT_URI=""

# --- Feature Flags: Mail Connectors -------------------------------------
MAIL_CONNECTOR=mock
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_PUBSUB_TOPIC=""

# --- Feature Flags: Calendar Connectors ---------------------------------
CALENDAR_CONNECTOR=mock

# --- Feature Flags: CRM Connectors --------------------------------------
CRM_CONNECTOR=mock
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI=""

# --- Feature Flags: Telephony Connectors --------------------------------
TELEPHONY_CONNECTOR=mock
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_BASE_URL=""

# --- Observability -------------------------------------------------------
LOG_LEVEL=info
# Opt-in: set to true once a Jaeger instance is reachable at the endpoint
# below (docker-compose.yml/docker-compose.dev.yml both provide one).
# See docs/OBSERVABILITY.md.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# --- Rate Limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Stricter limit applied only to POST /auth/login and /auth/refresh
# (apps/api/src/auth/auth.controller.ts) — see docs/ASSUMPTIONS.md Phase 15.
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=60
# Max WorkflowRuns a single tenant may have executing concurrently in the
# worker pool (docs/ORBIT_UNIFIED_IMPLEMENTATION_PLAN.md Phase 2, "Tenant
# Concurrency Fairness"). Excess triggers a short, deliberate re-queue delay.
TENANT_MAX_CONCURRENT_WORKFLOW_RUNS=5

# Channel Event Runtime (docs/CHANNEL_EVENT_RUNTIME_PLAN.md) — how often the
# scheduler fans out a connector sync job, and how many may run concurrently
# per tenant.
CHANNEL_SYNC_POLL_INTERVAL_MS=60000
TENANT_MAX_CONCURRENT_CHANNEL_SYNCS=2

# Build identity recorded as live-test evidence (Amendment 02 §19.4). Set by the build, e.g. ORBIT_BUILD_COMMIT=$(git rev-parse --short HEAD) docker compose build.
ORBIT_BUILD_COMMIT=""
